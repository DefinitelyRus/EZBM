@page
@model EZBM.DesktopClient.Pages.IndexModel
@using EZBM.DesktopClient.Helpers
@{
    ViewData["Title"] = "Analytics Dashboard";
}

@functions {
    public string GetRelativeTime(DateTime dt)
    {
        TimeSpan span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} minute(s) ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hour(s) ago";
        return $"{(int)span.TotalDays} day(s) ago";
    }
}

<div style="max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; padding: 20px 0;">
    
    <!-- Feed Header / Title Post -->
    <div style="background: white; border: 1px solid #e2e8f0; padding: 15px 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box; width: 100%;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 2em;">📢</span>
            <div>
                <h3 style="margin: 0; color: #2d3748;">What's happening today?</h3>
                <small style="color: #718096;">Store Analytics Feed</small>
            </div>
        </div>
    </div>

    <!-- Card 1: Today's Metrics Summary -->
    <div style="background: white; border: 1px solid #e2e8f0; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box; width: 100%; min-height: 300px; max-height: 1800px; overflow-y: auto;">
        <h4 style="margin: 0 0 15px 0; color: #4a5568; border-bottom: 1px solid #edf2f7; padding-bottom: 8px; text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;">📈 Key Metrics Summary</h4>
        <div style="display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed #edf2f7;">
                <span style="color: #718096;">Today's Sales:</span>
                <strong style="color: #2b6cb0; font-size: 1.2em;">@StateHelper.FormatCurrency(Model.TodaySales)</strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed #edf2f7;">
                <span style="color: #718096;">Today's Profit:</span>
                <strong style="color: #2f855a; font-size: 1.2em;">@StateHelper.FormatCurrency(Model.TodayProfit)</strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed #edf2f7;">
                <span style="color: #718096;">Gross Sales (All-Time):</span>
                <strong style="color: #4a5568; font-size: 1.2em;">@StateHelper.FormatCurrency(Model.TotalSales)</strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed #edf2f7;">
                <span style="color: #718096;">Gross Profit (All-Time):</span>
                <strong style="color: #4a5568; font-size: 1.2em;">@StateHelper.FormatCurrency(Model.GrossProfit)</strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0;">
                <span style="color: #718096;">Net Profit (All-Time):</span>
                <strong style="color: #c53030; font-size: 1.2em;">@StateHelper.FormatCurrency(Model.NetProfit)</strong>
            </div>
        </div>
    </div>

    <!-- Card 2: 7-Day Trend Chart -->
    <div style="background: white; border: 1px solid #e2e8f0; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box; width: 100%; min-height: 300px; max-height: 1800px; overflow-y: auto;">
        <h4 style="margin: 0 0 15px 0; color: #4a5568; border-bottom: 1px solid #edf2f7; padding-bottom: 8px; text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;">📊 7-Day Sales Volume Trend</h4>
        @{
            float maxSales = Model.SalesVolumeTrends.Count > 0 ? Model.SalesVolumeTrends.Max(t => t.TotalAmount) : 0f;
            if (maxSales < 100f) maxSales = 100f; // min scale
        }
        <div style="width: 100%; overflow-x: auto;">
            <svg width="100%" height="220" style="background-color: #fff; min-width: 500px;">
                <!-- Grid Lines -->
                <line x1="60" y1="20" x2="95%" y2="20" stroke="#f0f0f0" stroke-width="1" />
                <line x1="60" y1="70" x2="95%" y2="70" stroke="#f0f0f0" stroke-width="1" />
                <line x1="60" y1="120" x2="95%" y2="120" stroke="#f0f0f0" stroke-width="1" />
                <line x1="60" y1="170" x2="95%" y2="170" stroke="#e2e8f0" stroke-width="1.5" />

                <!-- Y Axis Labels -->
                <text x="50" y="24" font-size="10" text-anchor="end" fill="#718096">@StateHelper.FormatCurrency(maxSales)</text>
                <text x="50" y="99" font-size="10" text-anchor="end" fill="#718096">@StateHelper.FormatCurrency(maxSales * 0.5f)</text>
                <text x="50" y="174" font-size="10" text-anchor="end" fill="#718096">@StateHelper.FormatCurrency(0f)</text>

                <!-- Bars -->
                @{
                    int index = 0;
                    int barCount = Model.SalesVolumeTrends.Count;
                }
                @foreach (var trend in Model.SalesVolumeTrends)
                {
                    float barHeight = (trend.TotalAmount / maxSales) * 140f;
                    float xPos = 75 + (index * 60); // spacing
                    float yPos = 170 - barHeight;
                    
                    <rect x="@xPos" y="@yPos" width="28" height="@barHeight" fill="#3182ce">
                        <title>@trend.Date: @StateHelper.FormatCurrency(trend.TotalAmount) (@trend.SalesCount transactions)</title>
                    </rect>
                    
                    <!-- Value Label -->
                    @if (trend.TotalAmount > 0)
                    {
                        <g><text x="@(xPos + 14)" y="@(yPos - 6)" font-size="9" font-weight="bold" text-anchor="middle" fill="#2d3748">@StateHelper.FormatCurrency(trend.TotalAmount)</text></g>
                    }
                    
                    <!-- X Axis Date Label -->
                    var dateStr = DateTime.TryParse(trend.Date, out DateTime dt) ? dt.ToString("MM/dd") : trend.Date;
                    <g><text x="@(xPos + 14)" y="190" font-size="10" text-anchor="middle" fill="#4a5568">@dateStr</text></g>
                    
                    index++;
                }
            </svg>
        </div>
    </div>

    <!-- Card 3: Recent Transactions (Facebook/Twitter style) -->
    <div style="background: white; border: 1px solid #e2e8f0; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box; width: 100%; min-height: 300px; max-height: 1800px; overflow-y: auto;">
        <h4 style="margin: 0 0 15px 0; color: #4a5568; border-bottom: 1px solid #edf2f7; padding-bottom: 8px; text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;">💬 Recent Transactions Feed</h4>
        @if (Model.RecentSales.Count == 0)
        {
            <p style="color: #a0aec0; text-align: center; margin-top: 20px;">No transactions recorded yet.</p>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @foreach (var sale in Model.RecentSales)
                {
                    <div style="border: 1px solid #edf2f7; padding: 15px; background: #fafafa;">
                        <div style="margin-bottom: 10px;">
                            <strong style="color: #2d3748; font-size: 1.05em;">
                                @string.Join(", ", sale.SaleEntries.Select(e => e.Item != null ? e.Item.Name : "Unknown Item"))
                            </strong>
                        </div>
                        
                        <!-- Items List -->
                        <div style="margin-bottom: 10px; font-size: 0.9em; line-height: 1.4;">
                            <ul style="margin: 0; padding-left: 15px; color: #4a5568;">
                                @foreach (var entry in sale.SaleEntries)
                                {
                                    <li>
                                        <strong>@(entry.Item != null ? entry.Item.Name : "Unknown Item")</strong> 
                                        — @EZBM.Core.Tools.Utils.FormatDecimal(entry.Quantity) @(entry.Item != null ? entry.Item.UnitOfMeasurement.ToString() : "") 
                                        x @StateHelper.FormatCurrency(entry.UnitPrice) = <strong>@StateHelper.FormatCurrency(entry.Subtotal)</strong>
                                    </li>
                                }
                            </ul>
                        </div>
                        
                        <!-- Details Row -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-end; border-top: 1px solid #edf2f7; padding-top: 8px; font-size: 0.85em; color: #718096;">
                            <div>
                                <span>ID: @sale.InvoiceId</span> <span style="margin: 0 5px;">|</span>
                                <span>By: @(sale.Staff != null ? $"{sale.Staff.FirstName} {sale.Staff.LastName} ({sale.Staff.Username})" : "System")</span>
                                <div style="margin-top: 2px;">🕒 @GetRelativeTime(sale.Timestamp)</div>
                            </div>
                            <div style="text-align: right; font-weight: bold; color: #2d3748;">
                                Total Paid: <span style="font-size: 1.15em; color: #2b6cb0;">@StateHelper.FormatCurrency(sale.Amount)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Card 4: Low Stock Alerts -->
    <div style="background: white; border: 1px solid #e2e8f0; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box; width: 100%; min-height: 300px; max-height: 1800px; overflow-y: auto;">
        <h4 style="margin: 0 0 15px 0; color: #4a5568; border-bottom: 1px solid #edf2f7; padding-bottom: 8px; text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;">⚠️ Low Stock Warnings</h4>
        @if (Model.LowStockAlerts.Count == 0)
        {
            <div style="background-color: #f0fff4; color: #22543d; padding: 12px; border: 1px solid #c6f6d5; font-size: 0.9em;">
                All items are fully stocked based on thresholds.
            </div>
        }
        else
        {
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Product</th>
                        <th data-numeric="true">Stock</th>
                        <th data-numeric="true">Target</th>
                        <th data-numeric="true">Threshold</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model.LowStockAlerts)
                    {
                        <tr style="background-color: #fff5f5;">
                            <td style="color: #c53030; font-weight: bold;">@alert.Name</td>
                            <td style="color: #c53030; font-weight: bold;">@alert.Quantity</td>
                            <td>@alert.TargetStock</td>
                            <td>@(EZBM.Core.Tools.Utils.FormatDecimal(alert.LowStockThresholdPercentage * 100))%</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- Card 5: Top Popular Products -->
    <div style="background: white; border: 1px solid #e2e8f0; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box; width: 100%; min-height: 300px; max-height: 1800px; overflow-y: auto;">
        <h4 style="margin: 0 0 15px 0; color: #4a5568; border-bottom: 1px solid #edf2f7; padding-bottom: 8px; text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;">⭐ Top 5 Popular Products</h4>
        @if (Model.PopularProducts.Count == 0)
        {
            <p style="color: #a0aec0; text-align: center;">No product sales data yet.</p>
        }
        else
        {
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Product</th>
                        <th data-numeric="true">Sold</th>
                        <th data-numeric="true">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in Model.PopularProducts)
                    {
                        <tr>
                            <td><strong>@prod.Name</strong></td>
                            <td>@prod.TotalQuantitySold</td>
                            <td><strong>@StateHelper.FormatCurrency(prod.TotalRevenue)</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- Card 6: Cashier Leaderboard -->
    <div style="background: white; border: 1px solid #e2e8f0; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box; width: 100%; min-height: 300px; max-height: 1800px; overflow-y: auto;">
        <h4 style="margin: 0 0 15px 0; color: #4a5568; border-bottom: 1px solid #edf2f7; padding-bottom: 8px; text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;">🏆 Cashier Leaderboard</h4>
        @if (Model.CashierLeaderboard.Count == 0)
        {
            <p style="color: #a0aec0; text-align: center;">No cashier activity logged.</p>
        }
        else
        {
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Rank</th>
                        <th>Employee</th>
                        <th data-numeric="true">Sales Count</th>
                        <th data-numeric="true">Total Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rank = 1; }
                    @foreach (var cash in Model.CashierLeaderboard)
                    {
                        <tr>
                            <td>@rank</td>
                            <td><strong>@cash.Name</strong> (@cash.Username)</td>
                            <td>@cash.SalesCount</td>
                            <td><strong>@StateHelper.FormatCurrency(cash.TotalRevenue)</strong></td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        }
    </div>

</div>
