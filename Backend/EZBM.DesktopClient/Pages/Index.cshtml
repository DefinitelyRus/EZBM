@page
@model EZBM.DesktopClient.Pages.IndexModel
@{
    ViewData["Title"] = "Analytics Dashboard";
}

<h2>Page 2: Analytics Dashboard (Home Screen)</h2>

<div style="display: flex; gap: 20px; margin-bottom: 30px;">
    <div style="border: 1px solid #000; padding: 20px; min-width: 200px;">
        <h3>Today's Total Sales</h3>
        <p style="font-size: 1.8em; font-weight: bold; margin: 0;">
            $@Model.TodaySales.ToString("F2")
        </p>
    </div>

    <div style="border: 1px solid #000; padding: 20px; min-width: 200px;">
        <h3>Today's Total Profit</h3>
        <p style="font-size: 1.8em; font-weight: bold; margin: 0;">
            $@Model.TodayProfit.ToString("F2")
        </p>
    </div>
</div>

<hr />

<h3>Low Stock Alerts</h3>
<p>Flags physical items with stock level below 5 units.</p>

@if (Model.LowStockItems.Count == 0)
{
    <div style="background-color: #ccffcc; padding: 15px; border: 1px solid #00aa00;">
        <strong>Notice:</strong> All items are fully stocked.
    </div>
}
else
{
    <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; max-width: 600px; border-collapse: collapse;">
        <thead>
            <tr style="background-color: #eee;">
                <th>Item Name</th>
                <th>Quantity</th>
                <th>Unit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.LowStockItems)
            {
                <tr style="background-color: #ffcccc;">
                    <td>@item.Name</td>
                    <td><strong>@item.Quantity</strong></td>
                    <td>@item.UnitOfMeasurement</td>
                </tr>
            }
        </tbody>
    </table>
}
