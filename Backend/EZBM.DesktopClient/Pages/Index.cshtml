@page
@model EZBM.DesktopClient.Pages.IndexModel
@{
    ViewData["Title"] = "Analytics Dashboard";
}

<h2>Page 2: Analytics Dashboard (Home Screen)</h2>

<div style="display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap;">
    <div style="border: 1px solid #000; padding: 15px; min-width: 180px; background-color: #f0f8ff;">
        <h4 style="margin: 0 0 10px 0;">Today's Sales</h4>
        <p style="font-size: 1.6em; font-weight: bold; margin: 0; color: #0066cc;">
            @Model.TodaySales.ToString("C")
        </p>
    </div>

    <div style="border: 1px solid #000; padding: 15px; min-width: 180px; background-color: #f0fff0;">
        <h4 style="margin: 0 0 10px 0;">Today's Profit</h4>
        <p style="font-size: 1.6em; font-weight: bold; margin: 0; color: #008800;">
            @Model.TodayProfit.ToString("C")
        </p>
    </div>

    <div style="border: 1px solid #000; padding: 15px; min-width: 180px; background-color: #fafafa;">
        <h4 style="margin: 0 0 10px 0;">Gross Sales (All-Time)</h4>
        <p style="font-size: 1.6em; font-weight: bold; margin: 0;">
            @Model.TotalSales.ToString("C")
        </p>
    </div>

    <div style="border: 1px solid #000; padding: 15px; min-width: 180px; background-color: #fafafa;">
        <h4 style="margin: 0 0 10px 0;">Gross Profit (All-Time)</h4>
        <p style="font-size: 1.6em; font-weight: bold; margin: 0;">
            @Model.GrossProfit.ToString("C")
        </p>
    </div>

    <div style="border: 1px solid #000; padding: 15px; min-width: 180px; background-color: #fff0f5;">
        <h4 style="margin: 0 0 10px 0;">Net Profit (All-Time)</h4>
        <p style="font-size: 1.6em; font-weight: bold; margin: 0; color: #cc0066;">
            @Model.NetProfit.ToString("C")
        </p>
    </div>
</div>

<hr />

<div style="display: flex; gap: 40px; align-items: flex-start; flex-wrap: wrap;">
    <!-- Left Column (Alerts & Trends & Lists) -->
    <div style="flex: 2; min-width: 500px; display: flex; flex-direction: column; gap: 30px;">
        
        <!-- Low Stock Alerts -->
        <div>
            <h3>Low Stock Alerts (Product TPH)</h3>
            @if (Model.LowStockAlerts.Count == 0)
            {
                <div style="background-color: #ccffcc; padding: 15px; border: 1px solid #00aa00;">
                    <strong>Notice:</strong> All items are fully stocked based on their individual thresholds.
                </div>
            }
            else
            {
                <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #eee;">
                            <th>Product Name</th>
                            <th>Quantity In Stock</th>
                            <th>Target Stock</th>
                            <th>Warning Threshold</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in Model.LowStockAlerts)
                        {
                            <tr style="background-color: #ffcccc;">
                                <td>@alert.Name</td>
                                <td><strong>@alert.Quantity</strong></td>
                                <td>@alert.TargetStock</td>
                                <td>@(alert.LowStockThresholdPercentage * 100)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Sales Volume Trends -->
        <div>
            <h3>Sales Volume Trends (Last 7 Days)</h3>
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Date</th>
                        <th>Sales Amount</th>
                        <th>Transaction Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trend in Model.SalesVolumeTrends)
                    {
                        <tr>
                            <td>@trend.Date</td>
                            <td>@trend.TotalAmount.ToString("C")</td>
                            <td>@trend.SalesCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Popular Products -->
        <div>
            <h3>Top 5 Popular Products</h3>
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Product Name</th>
                        <th>Quantity Sold</th>
                        <th>Total Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in Model.PopularProducts)
                    {
                        <tr>
                            <td>@prod.Name</td>
                            <td>@prod.TotalQuantitySold</td>
                            <td>@prod.TotalRevenue.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Cashier Leaderboard -->
        <div>
            <h3>Cashier Leaderboard</h3>
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Rank</th>
                        <th>Employee</th>
                        <th>Username</th>
                        <th>Transaction Count</th>
                        <th>Total Sales Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rank = 1; }
                    @foreach (var cash in Model.CashierLeaderboard)
                    {
                        <tr>
                            <td>@rank</td>
                            <td><strong>@cash.Name</strong></td>
                            <td>@cash.Username</td>
                            <td>@cash.SalesCount</td>
                            <td>@cash.TotalRevenue.ToString("C")</td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- Right Column (Recent Transactions Feed) -->
    <div style="width: 380px; border: 1px solid #000; padding: 15px; background-color: #fafafa;">
        <h3>Recent Transactions (Latest 10)</h3>
        @if (Model.RecentSales.Count == 0)
        {
            <p style="color: #888; text-align: center;">No transactions recorded yet.</p>
        }
        else
        {
            <ul style="list-style-type: none; padding-left: 0; margin: 0;">
                @foreach (var sale in Model.RecentSales)
                {
                    <li style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                        <div style="display: flex; justify-content: space-between; font-weight: bold;">
                            <span>@sale.InvoiceId</span>
                            <span>@sale.Amount.ToString("C")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.85em; color: #555; margin-top: 3px;">
                            <span>By: @sale.Staff.FirstName @sale.Staff.LastName</span>
                            <span>@sale.Timestamp.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
