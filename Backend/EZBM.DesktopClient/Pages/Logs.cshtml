@page
@model EZBM.DesktopClient.Pages.LogsModel
@{
    ViewData["Title"] = "System Logs & Records";
    bool isAttendance = Model.ActiveTab == "attendance";
    bool isPayroll = Model.ActiveTab == "payroll";
    bool isActions = Model.ActiveTab == "actions";
}

<h2>Page 6: Shift Attendance, Payroll & Action Audit Logs</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: #ffcccc; color: #cc0000; border: 1px solid #cc0000; padding: 10px; margin-bottom: 20px;">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background-color: #ccffcc; color: #008800; border: 1px solid #008800; padding: 10px; margin-bottom: 20px;">
        <strong>Success:</strong> @Model.SuccessMessage
    </div>
}

<!-- Tab Headers -->
<div style="margin-bottom: 20px; display: flex; gap: 0;">
    <a href="/Logs?tab=attendance" style="padding: 10px; font-weight: @(isAttendance ? "bold" : "normal"); border: 1px solid #000; background-color: @(isAttendance ? "#eee" : "#fff"); text-decoration: none;">
        Attendance Ledger
    </a>
    <a href="/Logs?tab=payroll" style="padding: 10px; font-weight: @(isPayroll ? "bold" : "normal"); border: 1px solid #000; border-left: none; background-color: @(isPayroll ? "#eee" : "#fff"); text-decoration: none;">
        Payroll Records
    </a>
    <a href="/Logs?tab=actions" style="padding: 10px; font-weight: @(isActions ? "bold" : "normal"); border: 1px solid #000; border-left: none; background-color: @(isActions ? "#eee" : "#fff"); text-decoration: none;">
        Action Audit Logs
    </a>
</div>

<div style="display: flex; gap: 40px; align-items: flex-start;">
    @if (isAttendance)
    {
        <!-- Attendance Tab Content -->
        <div style="flex-grow: 1;">
            <h3>Attendance Ledger</h3>
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Log ID</th>
                        <th>Employee</th>
                        <th>Clock In (UTC)</th>
                        <th>Clock Out (UTC)</th>
                        <th>Total Hours</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.AttendanceLogs)
                    {
                        var totalHours = log.TimeOut.HasValue ? (log.TimeOut.Value - log.TimeIn).TotalHours : (double?)null;
                        <tr>
                            <td>@log.Id</td>
                            <td><strong>@log.Staff.Username</strong></td>
                            <td>@log.TimeIn.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(log.TimeOut?.ToString("yyyy-MM-dd HH:mm:ss") ?? "STILL CLOCKED IN")</td>
                            <td>@(totalHours.HasValue ? totalHours.Value.ToString("F2") : "N/A")</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteAttendance" style="display: inline;" onsubmit="return confirm('Delete this attendance entry?');">
                                    <input type="hidden" name="id" value="@log.Id" />
                                    <button type="submit" style="color: red; border: none; background: none; text-decoration: underline; cursor: pointer; padding: 0;">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Add Attendance Entry -->
        <div style="width: 300px; border: 1px solid #000; padding: 20px; background-color: #f9f9f9;">
            <h3>Add Attendance Entry</h3>
            <form method="post" asp-page-handler="CreateAttendance">
                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Employee:</label>
                    <select name="staffId" style="width: 100%;" required>
                        @foreach (var staff in Model.StaffList)
                        {
                            <option value="@staff.Id">@staff.Username</option>
                        }
                    </select>
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Clock In Time:</label>
                    <input type="datetime-local" name="timeIn" required style="width: 100%;" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold;">Clock Out Time (Optional):</label>
                    <input type="datetime-local" name="timeOut" style="width: 100%;" />
                </div>

                <button type="submit" style="background-color: green; color: white; padding: 5px 10px; font-weight: bold; border: none; cursor: pointer;">Save Log</button>
            </form>
        </div>
    }
    else if (isPayroll)
    {
        <!-- Payroll Tab Content -->
        <div style="flex-grow: 1;">
            <h3>Payroll Records History</h3>
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Invoice ID</th>
                        <th>Employee</th>
                        <th>Period Start</th>
                        <th>Period End</th>
                        <th>Hours</th>
                        <th>Gross Pay</th>
                        <th>Upgrade Comm.</th>
                        <th>Net Paid</th>
                        <th>Pay Date</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pay in Model.PayrollLogs)
                    {
                        <tr>
                            <td>@pay.InvoiceId</td>
                            <td><strong>@pay.Staff.Username</strong></td>
                            <td>@pay.PeriodStart.ToShortDateString()</td>
                            <td>@pay.PeriodEnd.ToShortDateString()</td>
                            <td>@pay.TotalHours.ToString("F1")</td>
                            <td>@pay.GrossAmount.ToString("C")</td>
                            <td>@pay.Modifiers.ToString("C")</td>
                            <td><strong>@pay.Amount.ToString("C")</strong></td>
                            <td>@pay.Timestamp.ToShortDateString()</td>
                            <td>@pay.Notes</td>
                            <td>
                                <form method="post" asp-page-handler="DeletePayroll" style="display: inline;" onsubmit="return confirm('Delete this payroll entry?');">
                                    <input type="hidden" name="id" value="@pay.Id" />
                                    <button type="submit" style="color: red; border: none; background: none; text-decoration: underline; cursor: pointer; padding: 0;">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Add Payroll Entry -->
        <div style="width: 300px; border: 1px solid #000; padding: 20px; background-color: #f9f9f9;">
            <h3>Log Payroll Payment</h3>
            <form method="post" asp-page-handler="CreatePayroll" id="payrollForm">
                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Employee:</label>
                    <select name="staffId" id="payStaffId" style="width: 100%;" required>
                        @foreach (var staff in Model.StaffList)
                        {
                            <option value="@staff.Id">@staff.Username</option>
                        }
                    </select>
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Period Start:</label>
                    <input type="date" name="periodStart" id="payPeriodStart" required style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Period End:</label>
                    <input type="date" name="periodEnd" id="payPeriodEnd" required style="width: 100%;" />
                </div>

                <div style="margin-bottom: 15px; text-align: center;">
                    <button type="button" onclick="autoCalculatePayroll()" style="background-color: #007bff; color: white; border: none; padding: 6px 12px; font-weight: bold; cursor: pointer; width: 100%;">
                        ⚡ Auto-Calculate Stats
                    </button>
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Total Hours:</label>
                    <input type="number" step="0.1" min="0" name="totalHours" id="payTotalHours" required style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Gross Amount ($):</label>
                    <input type="number" step="0.01" min="0" name="grossAmount" id="payGrossAmount" required style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Upgrade Commissions ($):</label>
                    <input type="number" step="0.01" name="modifiers" id="payModifiers" value="0.00" required style="width: 100%;" />
                    <small style="color: #666;">Automatically subtracts lower tier values already paid.</small>
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Net Paid ($):</label>
                    <input type="number" step="0.01" min="0" name="netAmount" id="payNetAmount" required style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Payment Date:</label>
                    <input type="date" name="payDate" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold;">Notes:</label>
                    <input type="text" name="notes" id="payNotes" placeholder="e.g. Regular monthly pay" style="width: 100%;" />
                </div>

                <button type="submit" style="background-color: green; color: white; padding: 5px 10px; font-weight: bold; border: none; cursor: pointer; width: 100%;">Log Payment</button>
            </form>
        </div>
    }
    else if (isActions)
    {
        <!-- Action Audit Logs Tab -->
        <div style="flex-grow: 1;">
            <h3>System Action Audit Logs</h3>
            <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th>Timestamp (UTC)</th>
                        <th>Action Type</th>
                        <th>Operator</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.ActionLogs)
                    {
                        <tr>
                            <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span style="font-weight: bold;">@log.ActionType</span></td>
                            <td><strong>@log.OperatorUsername</strong></td>
                            <td>@log.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    @if (isPayroll)
    {
        <script>
            async function autoCalculatePayroll() {
                let staffId = document.getElementById("payStaffId").value;
                let start = document.getElementById("payPeriodStart").value;
                let end = document.getElementById("payPeriodEnd").value;

                if (!staffId || !start || !end) {
                    alert("Please select Employee, Period Start, and Period End first.");
                    return;
                }

                try {
                    let url = `/Logs?handler=CalculatePayrollStats&staffId=${staffId}&periodStart=${start}&periodEnd=${end}`;
                    let response = await fetch(url);
                    let result = await response.json();

                    if (result.success) {
                        document.getElementById("payTotalHours").value = result.totalHours;
                        document.getElementById("payGrossAmount").value = result.grossAmount;
                        document.getElementById("payModifiers").value = result.commission;
                        document.getElementById("payNetAmount").value = result.netAmount;
                        document.getElementById("payNotes").value = `Includes $${result.commission.toFixed(2)} Net Upgrade Commission modifiers`;
                        alert("Calculations computed! Form populated.");
                    } else {
                        alert("Failed to compute payroll stats: " + result.message);
                    }
                } catch (e) {
                    alert("Network error: " + e.message);
                }
            }
        </script>
    }
}
