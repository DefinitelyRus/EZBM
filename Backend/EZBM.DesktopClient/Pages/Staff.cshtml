@page
@model EZBM.DesktopClient.Pages.StaffModel
@using EZBM.Core.Entities
@{
    ViewData["Title"] = "Staff Management";
    bool isEditing = Model.EditingStaff is not null;
}

<h2>Page 5: Staff Management</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: #ffcccc; color: #cc0000; border: 1px solid #cc0000; padding: 10px; margin-bottom: 20px;">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background-color: #ccffcc; color: #008800; border: 1px solid #008800; padding: 10px; margin-bottom: 20px;">
        <strong>Success:</strong> @Model.SuccessMessage
    </div>
}

<div style="display: flex; gap: 40px; align-items: flex-start;">
    <!-- Directory Table Section -->
    <div style="flex-grow: 1;">
        <h3>Staff Profile Directory</h3>
        
        <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #eee;">
                    <th>ID</th>
                    <th>Username</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Position</th>
                    <th>Pay Frequency</th>
                    <th>Pay Rate</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model.StaffList)
                {
                    <tr>
                        <td>@staff.Id</td>
                        <td><strong>@staff.Username</strong></td>
                        <td>@staff.FirstName @staff.LastName</td>
                        <td>@staff.Email</td>
                        <td>@staff.PhoneNumber</td>
                        <td>@(staff.Position ?? "Staff")</td>
                        <td>@staff.PayFrequency</td>
                        <td>@staff.PayRate.ToString("C")</td>
                        <td>
                            <a href="/Staff?action=edit&id=@staff.Id">Edit</a>
                            |
                            <form method="post" asp-page-handler="Delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this staff member?');">
                                <input type="hidden" name="id" value="@staff.Id" />
                                <button type="submit" style="color: red; border: none; background: none; text-decoration: underline; cursor: pointer; padding: 0;">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Add / Edit Profile Workspace -->
    <div style="width: 320px; border: 1px solid #000; padding: 20px; background-color: #f9f9f9;">
        @if (isEditing)
        {
            <h3>Edit Staff Profile (ID: @Model.EditingStaff!.Id)</h3>
            <form method="post" asp-page-handler="Update">
                <input type="hidden" name="id" value="@Model.EditingStaff.Id" />
                
                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Username:</label>
                    <input type="text" name="username" value="@Model.EditingStaff.Username" required style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Password:</label>
                    <input type="text" name="password" value="@Model.EditingStaff.Password" style="width: 100%;" />
                </div>
                
                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">First Name:</label>
                    <input type="text" name="firstName" value="@Model.EditingStaff.FirstName" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Last Name:</label>
                    <input type="text" name="lastName" value="@Model.EditingStaff.LastName" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Email:</label>
                    <input type="email" name="email" value="@Model.EditingStaff.Email" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Phone Number:</label>
                    <input type="text" name="phoneNumber" value="@Model.EditingStaff.PhoneNumber" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Position/Role:</label>
                    <input type="text" name="position" value="@Model.EditingStaff.Position" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Pay Frequency:</label>
                    <select name="payFrequency" style="width: 100%;">
                        @foreach (Staff.Frequency freq in Enum.GetValues<Staff.Frequency>())
                        {
                            @if (Model.EditingStaff.PayFrequency == freq)
                            {
                                <option value="@freq" selected>@freq</option>
                            }
                            else
                            {
                                <option value="@freq">@freq</option>
                            }
                        }
                    </select>
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold;">Pay Rate ($):</label>
                    <input type="number" step="0.01" min="0" name="payRate" value="@Model.EditingStaff.PayRate" required style="width: 100%;" />
                </div>

                <button type="submit" style="background-color: blue; color: white; padding: 5px 10px; font-weight: bold;">Update Profile</button>
                <a href="/Staff" style="margin-left: 10px;">Cancel</a>
            </form>
        }
        else
        {
            <h3>Add New Employee</h3>
            <form method="post" asp-page-handler="Create">
                
                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Username:</label>
                    <input type="text" name="username" required style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Password:</label>
                    <input type="text" name="password" style="width: 100%;" />
                </div>
                
                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">First Name:</label>
                    <input type="text" name="firstName" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Last Name:</label>
                    <input type="text" name="lastName" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Email:</label>
                    <input type="email" name="email" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Phone Number:</label>
                    <input type="text" name="phoneNumber" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Position/Role:</label>
                    <input type="text" name="position" style="width: 100%;" />
                </div>

                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold;">Pay Frequency:</label>
                    <select name="payFrequency" style="width: 100%;">
                        @foreach (Staff.Frequency freq in Enum.GetValues<Staff.Frequency>())
                        {
                            <option value="@freq">@freq</option>
                        }
                    </select>
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold;">Pay Rate ($):</label>
                    <input type="number" step="0.01" min="0" name="payRate" value="0.00" required style="width: 100%;" />
                </div>

                <button type="submit" style="background-color: green; color: white; padding: 5px 10px; font-weight: bold;">Register Employee</button>
            </form>
        }
    </div>
</div>
