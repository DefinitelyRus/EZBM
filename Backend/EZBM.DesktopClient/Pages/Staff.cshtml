@page
@model EZBM.DesktopClient.Pages.StaffModel
@using EZBM.DesktopClient.Helpers
@{
    ViewData["Title"] = "Staff Directory & Roles Matrix";
    bool isDirectory = Model.ActiveTab == "directory" || string.IsNullOrEmpty(Model.ActiveTab);
    bool isRoles = Model.ActiveTab == "roles";
}

<h2>Staff Management & Security Roles</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: #fff5f5; color: #e53e3e; border: 1px solid #fed7d7; padding: 12px; margin-bottom: 20px; border-radius: 6px;">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background-color: #f0fff4; color: #38a169; border: 1px solid #c6f6d5; padding: 12px; margin-bottom: 20px; border-radius: 6px;">
        <strong>Success:</strong> @Model.SuccessMessage
    </div>
}

<!-- Google Docs Style Subtabs -->
<div class="subtabs-container">
    <a href="/Staff?tab=directory" class="subtab-item @(isDirectory ? "active" : "")">Staff Directory</a>
    <a href="/Staff?tab=roles" class="subtab-item @(isRoles ? "active" : "")">Security Roles Matrix</a>
</div>

<div style="display: flex; gap: 40px; align-items: flex-start; flex-wrap: wrap;">
    @if (isDirectory)
    {
        <!-- Tab 1: Staff Directory -->
        <div style="flex-grow: 1; min-width: 600px;">
            <h3>Active Staff Profiles</h3>
            <table border="1" cellpadding="5" cellspacing="0" id="staffTable" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #eee;">
                        <th data-hide-default="true">ID</th>
                        <th>Name</th>
                        <th>Position / Access Type</th>
                        <th data-hide-default="true">Email</th>
                        <th data-hide-default="true">Phone</th>
                        <th>Assigned Roles</th>
                        <th data-numeric="true" data-hide-default="true">Pay Rate</th>
                        <th data-numeric="true" data-hide-default="true">Comm. Override</th>
                        <th data-no-sort="true">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.StaffList)
                    {
                        <tr>
                            <td>@staff.Id</td>
                            <td><strong>@staff.FirstName @staff.LastName</strong> (@staff.Username)</td>
                            <td>@(staff.Position ?? "Staff") / @staff.AccessType</td>
                            <td>@staff.Email</td>
                            <td>@staff.PhoneNumber</td>
                            <td>
                                @if (staff.Roles.Count == 0)
                                {
                                    <span style="color: #a0aec0; font-style: italic;">None Assigned</span>
                                }
                                else
                                {
                                    @string.Join(", ", staff.Roles.Select(r => r.Name))
                                }
                            </td>
                            <td>@StateHelper.FormatCurrency(staff.PayRate) (@staff.PayFrequency)</td>
                            <td>@(staff.CommissionRate.HasValue ? staff.CommissionRate.Value.ToString("F2") : "1.00 (Default)")</td>
                            <td>
                                <div class="action-buttons">
                                    <a href="/Staff?action=edit&id=@staff.Id&tab=directory" class="btn" style="padding: 2px 6px; font-size: 0.85em;">Edit</a>
                                    <form method="post" asp-page-handler="Delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this staff member?');">
                                        <input type="hidden" name="id" value="@staff.Id" />
                                        <button type="submit" class="btn btn-danger" style="padding: 2px 6px; font-size: 0.85em;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Add or Edit Side Panel -->
        <div style="width: 350px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; background-color: white; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box;">
            @if (Model.EditingStaff is not null)
            {
                <h3 style="margin-top:0;">Edit Employee Profile</h3>
                <form method="post" asp-page-handler="Update">
                    <input type="hidden" name="id" value="@Model.EditingStaff.Id" />
                    
                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Username:</label>
                        <input type="text" name="username" value="@Model.EditingStaff.Username" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Password (blank to keep same):</label>
                        <input type="password" name="password" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" placeholder="••••••••" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">First Name:</label>
                        <input type="text" name="firstName" value="@Model.EditingStaff.FirstName" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Last Name:</label>
                        <input type="text" name="lastName" value="@Model.EditingStaff.LastName" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Email:</label>
                        <input type="email" name="email" value="@Model.EditingStaff.Email" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Phone:</label>
                        <input type="text" name="phoneNumber" value="@Model.EditingStaff.PhoneNumber" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Position/Title:</label>
                        <input type="text" name="position" value="@Model.EditingStaff.Position" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Pay Frequency:</label>
                        <select name="payFrequency" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                            @foreach (EZBM.Core.Entities.Staff.Frequency freq in Enum.GetValues<EZBM.Core.Entities.Staff.Frequency>())
                            {
                                @if (Model.EditingStaff.PayFrequency == freq)
                                {
                                    <option value="@freq" selected>@freq</option>
                                }
                                else
                                {
                                    <option value="@freq">@freq</option>
                                }
                            }
                        </select>
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Pay Rate (@StateHelper.GetCurrencySymbol()):</label>
                        <input type="number" step="0.01" min="0" name="payRate" value="@Model.EditingStaff.PayRate" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Commission Override Rate:</label>
                        <input type="number" step="0.01" min="0" name="commissionRate" value="@Model.EditingStaff.CommissionRate" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                        <small style="color: #718096; display: block; margin-top: 2px;">Leave blank for default (1.0)</small>
                    </div>

                    <div style="margin-bottom: 15px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Security Roles (Hold Ctrl to multi-select):</label>
                        <select name="roleIds" multiple style="width: 100%; height: 80px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                            @foreach (var role in Model.RolesList)
                            {
                                bool isAssigned = Model.EditingStaff.Roles.Any(r => r.Id == role.Id);
                                @if (isAssigned)
                                {
                                    <option value="@role.Id" selected>@role.Name</option>
                                }
                                else
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div style="display: flex; gap: 10px;">
                        <button type="submit" class="btn btn-primary" style="flex: 1;">Update Profile</button>
                        <a href="/Staff?tab=directory" class="btn" style="flex: 1; text-align: center;">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <h3 style="margin-top:0;">Add New Employee</h3>
                <form method="post" asp-page-handler="Create">
                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Username:</label>
                        <input type="text" name="username" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Password:</label>
                        <input type="password" name="password" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>
                    
                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">First Name:</label>
                        <input type="text" name="firstName" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Last Name:</label>
                        <input type="text" name="lastName" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Email:</label>
                        <input type="email" name="email" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Phone Number:</label>
                        <input type="text" name="phoneNumber" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Position/Title:</label>
                        <input type="text" name="position" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Pay Frequency:</label>
                        <select name="payFrequency" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                            @foreach (EZBM.Core.Entities.Staff.Frequency freq in Enum.GetValues<EZBM.Core.Entities.Staff.Frequency>())
                            {
                                <option value="@freq">@freq</option>
                            }
                        </select>
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Pay Rate (@StateHelper.GetCurrencySymbol()):</label>
                        <input type="number" step="0.01" min="0" name="payRate" value="0.00" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Commission Override Rate:</label>
                        <input type="number" step="0.01" min="0" name="commissionRate" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                        <small style="color: #718096; display: block; margin-top: 2px;">Leave blank for default multiplier (1.0)</small>
                    </div>

                    <div style="margin-bottom: 15px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Security Roles (Hold Ctrl to multi-select):</label>
                        <select name="roleIds" multiple style="width: 100%; height: 80px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                            @foreach (var role in Model.RolesList)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success" style="width: 100%;">Register Employee</button>
                </form>
            }
        </div>
    }
    else if (isRoles)
    {
        <!-- Tab 2: Security Roles Matrix -->
        <div style="flex-grow: 1; min-width: 600px;">
            <h3>Granular Role Permissions Matrix</h3>
            
            @if (Model.RolesList.Count == 0)
            {
                <div style="background-color: #fffaf0; padding: 15px; border: 1px solid #feebc8; margin-bottom: 20px; border-radius: 6px; color: #c05621;">
                    <strong>Notice:</strong> No security roles have been created yet. Add your first role using the form on the right.
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="SaveRolePermissions">
                    <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #eee;">
                                <th>System Action / Permission</th>
                                @foreach (var role in Model.RolesList)
                                {
                                    <th style="text-align: center;">
                                        @role.Name
                                        <div style="margin-top: 6px; font-weight: normal;">
                                            <button type="submit" class="btn btn-danger" style="padding: 2px 6px; font-size: 0.8em;" asp-page-handler="DeleteRole" asp-route-id="@role.Id" onclick="return confirm('Are you sure you want to delete role @role.Name?');">Delete Role</button>
                                        </div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var permissions = new List<string> { "Checkout", "DeleteLogs", "ModifyInventory", "ManagePayroll", "ManageSettings" };
                            }
                            @foreach (var perm in permissions)
                            {
                                <tr>
                                    <td><strong>@perm</strong></td>
                                    @foreach (var role in Model.RolesList)
                                    {
                                        var permMap = new Dictionary<string, int>();
                                        try
                                        {
                                            permMap = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(role.PermissionsJson) ?? new Dictionary<string, int>();
                                        }
                                        catch { }
                                        int curVal = permMap.GetValueOrDefault(perm, 0);
                                        
                                        <td style="text-align: center;">
                                            <div style="display: inline-flex; gap: 8px; justify-content: center; align-items: center;">
                                                <label style="font-size: 0.85em; font-weight: normal; cursor: pointer; display: flex; align-items: center; gap: 3px;">
                                                    <input type="radio" name="perm_@(role.Id)_@(perm)" value="1" @(curVal == 1 ? "checked" : "") /> Allow
                                                </label>
                                                <label style="font-size: 0.85em; font-weight: normal; cursor: pointer; display: flex; align-items: center; gap: 3px;">
                                                    <input type="radio" name="perm_@(role.Id)_@(perm)" value="0" @(curVal == 0 ? "checked" : "") /> Inherit
                                                </label>
                                                <label style="font-size: 0.85em; font-weight: normal; cursor: pointer; display: flex; align-items: center; gap: 3px;">
                                                    <input type="radio" name="perm_@(role.Id)_@(perm)" value="-1" @(curVal == -1 ? "checked" : "") /> Deny
                                                </label>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>

                    <button type="submit" class="btn btn-primary" style="margin-top: 15px;">
                        Save Permissions Matrix
                    </button>
                </form>
            }
        </div>

        <!-- Add Custom Role Panel -->
        <div style="width: 320px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; background-color: white; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box;">
            <h3 style="margin-top:0;">Create Security Role</h3>
            <form method="post" asp-page-handler="CreateRole">
                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 5px;">Role Name:</label>
                    <input type="text" name="roleName" required placeholder="e.g. Cashier, Supervisor" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>
                
                <button type="submit" class="btn btn-success" style="width: 100%;">
                    Create Role
                </button>
            </form>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const table = document.getElementById("staffTable");
            if (table) {
                initCommonTable(table);
            }
        });
    </script>
}
