@page
@model EZBM.DesktopClient.Pages.InventoryModel
@using EZBM.Core.Entities
@using EZBM.DesktopClient.Helpers
@{
    ViewData["Title"] = "Inventory Management";
    bool isEditing = Model.EditingItem is not null;
}

<h2>Inventory Management</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: #fff5f5; color: #e53e3e; border: 1px solid #fed7d7; padding: 12px; margin-bottom: 20px; border-radius: 6px;">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background-color: #f0fff4; color: #38a169; border: 1px solid #c6f6d5; padding: 12px; margin-bottom: 20px; border-radius: 6px;">
        <strong>Success:</strong> @Model.SuccessMessage
    </div>
}

<div style="display: flex; gap: 40px; align-items: flex-start; flex-wrap: wrap;">
    <!-- Catalog Table Section -->
    <div style="flex-grow: 1; min-width: 600px;">
        <h3>Product & Service Catalog</h3>
        
        <!-- Search bar -->
        <div style="margin-bottom: 15px;">
            <label for="searchInput" style="font-weight: bold; margin-right: 10px;">Search Catalog:</label>
            <input type="text" id="searchInput" placeholder="Type to filter in real-time..." style="width: 300px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" onkeyup="filterTable()" />
        </div>

        <table border="1" cellpadding="5" cellspacing="0" id="catalogTable" data-common-table="true" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #eee;">
                    <th data-hide-default="true">ID</th>
                    <th>Name</th>
                    <th data-hide-default="true">Type</th>
                    <th>Description</th>
                    <th data-hide-default="true">For Sale?</th>
                    <th data-numeric="true">Cost Price</th>
                    <th data-numeric="true">Sale Price</th>
                    <th>Stock Level</th>
                    <th data-numeric="true" data-hide-default="true">Threshold %</th>
                    <th data-date="true" data-hide-default="true">Expiration</th>
                    <th data-hide-default="true">Tags</th>
                    <th data-no-sort="true">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    bool isLowStock = false;
                    if (item is Product prod)
                    {
                        isLowStock = prod.Quantity < prod.TargetStock * prod.LowStockThresholdPercentage;
                    }
                    <tr style="@(isLowStock ? "background-color: #fff5f5; color: #c53030;" : "")">
                        <td>@item.Id</td>
                        <td class="search-name"><strong>@item.Name</strong></td>
                        <td>@(item is Service ? "Service" : "Product")</td>
                        <td>@item.Description</td>
                        <td>@(item.IsForSale ? "Yes" : "No")</td>
                        <td>@StateHelper.FormatCurrency(item.Cost)</td>
                        <td>@StateHelper.FormatCurrency(item.SalePrice)</td>
                        <td>
                            <strong>@item.Quantity @item.UnitOfMeasurement</strong>
                            @if (item is Product p)
                            {
                                <span style="color: #718096; font-size: 0.9em;"> / @p.TargetStock.ToString("F1") @item.UnitOfMeasurement</span>
                            }
                        </td>
                        <td>@(item is Product pThresh ? $"{(pThresh.LowStockThresholdPercentage * 100):F0}%" : "N/A")</td>
                        <td>@StateHelper.FormatDate(item.ExpirationDate, HttpContext)</td>
                        <td>@string.Join(", ", item.Tags)</td>
                        <td>
                            <div class="action-buttons">
                                <a href="/Inventory?action=edit&id=@item.Id" class="btn" style="padding: 2px 6px; font-size: 0.85em;">Edit</a>
                                <form method="post" asp-page-handler="Delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this item?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger" style="padding: 2px 6px; font-size: 0.85em;">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Add / Edit Item Form Workspace -->
    <div style="width: 350px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; background-color: white; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        @if (isEditing)
        {
            <h3 style="margin-top:0;">Edit Item (ID: @Model.EditingItem!.Id)</h3>
            <form method="post" asp-page-handler="Update">
                <input type="hidden" name="id" value="@Model.EditingItem.Id" />
                
                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Name:</label>
                    <input type="text" name="name" value="@Model.EditingItem.Name" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>
                
                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Description:</label>
                    <textarea name="description" style="width: 100%; height: 50px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">@Model.EditingItem.Description</textarea>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="font-weight: bold; display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" name="isForSale" value="true" @(Model.EditingItem.IsForSale ? "checked" : "") />
                        Available For Sale
                    </label>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Item Type:</label>
                    <input type="hidden" name="itemType" value="@(Model.EditingItem is Service ? "Service" : "Product")" />
                    <strong>@(Model.EditingItem is Service ? "Service" : "Product")</strong>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Cost Price (@StateHelper.GetCurrencySymbol()):</label>
                    <input type="number" step="0.01" min="0" name="cost" value="@Model.EditingItem.Cost" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Sale Price (@StateHelper.GetCurrencySymbol()):</label>
                    <input type="number" step="0.01" min="0" name="salePrice" value="@Model.EditingItem.SalePrice" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Stock Quantity:</label>
                    <input type="number" step="0.01" min="0" name="quantity" value="@Model.EditingItem.Quantity" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                @if (Model.EditingItem is Product pEdit)
                {
                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Target Stock:</label>
                        <input type="number" step="0.01" min="0" name="targetStock" value="@pEdit.TargetStock" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Low Stock Warning Threshold (%):</label>
                        <input type="number" step="0.01" min="0" max="1" name="lowStockThresholdPercentage" value="@pEdit.LowStockThresholdPercentage" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                        <small style="color: #718096;">Enter fraction (e.g. 0.20 for 20%)</small>
                    </div>
                }

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Unit of Measurement:</label>
                    <select name="unitOfMeasurement" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                        @foreach (Item.Unit unit in Enum.GetValues<Item.Unit>())
                        {
                            @if (Model.EditingItem.UnitOfMeasurement == unit)
                            {
                                <option value="@unit" selected>@unit</option>
                            }
                            else
                            {
                                <option value="@unit">@unit</option>
                            }
                        }
                    </select>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Expiration Date:</label>
                    <input type="date" name="expirationDate" value="@(Model.EditingItem.ExpirationDate?.ToString("yyyy-MM-dd"))" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Tags (Hold Ctrl to multi-select):</label>
                    <select name="tags" multiple style="width: 100%; height: 80px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                        @foreach (Item.Tag tag in Enum.GetValues<Item.Tag>())
                        {
                            @if (Model.EditingItem.Tags.Contains(tag))
                            {
                                <option value="@tag" selected>@tag</option>
                            }
                            else
                            {
                                <option value="@tag">@tag</option>
                            }
                        }
                    </select>
                </div>

                <div style="display: flex; gap: 10px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">Update Item</button>
                    <a href="/Inventory" class="btn" style="flex: 1; text-align: center;">Cancel</a>
                </div>
            </form>
        }
        else
        {
            <h3 style="margin-top:0;">Add New Item</h3>
            <form method="post" asp-page-handler="Create" id="createItemForm">
                
                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Item Type:</label>
                    <select name="itemType" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" onchange="toggleItemTypeFields(this.form)">
                        <option value="Product" selected>Product</option>
                        <option value="Service">Service</option>
                    </select>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Name:</label>
                    <input type="text" name="name" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>
                
                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Description:</label>
                    <textarea name="description" style="width: 100%; height: 50px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;"></textarea>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="font-weight: bold; display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" name="isForSale" value="true" checked />
                        Available For Sale
                    </label>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Cost Price (@StateHelper.GetCurrencySymbol()):</label>
                    <input type="number" step="0.01" min="0" name="cost" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Sale Price (@StateHelper.GetCurrencySymbol()):</label>
                    <input type="number" step="0.01" min="0" name="salePrice" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Stock Quantity:</label>
                    <input type="number" step="0.01" min="0" name="quantity" value="0" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                <div class="product-only-field" style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Target Stock:</label>
                    <input type="number" step="0.01" min="0" name="targetStock" value="0" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                <div class="product-only-field" style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Low Stock Warning Threshold (%):</label>
                    <input type="number" step="0.01" min="0" max="1" name="lowStockThresholdPercentage" value="0.20" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                    <small style="color: #718096;">Enter fraction (e.g. 0.20 for 20%)</small>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Unit of Measurement:</label>
                    <select name="unitOfMeasurement" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                        @foreach (Item.Unit unit in Enum.GetValues<Item.Unit>())
                        {
                            <option value="@unit">@unit</option>
                        }
                    </select>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Expiration Date:</label>
                    <input type="date" name="expirationDate" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Tags (Hold Ctrl to multi-select):</label>
                    <select name="tags" multiple style="width: 100%; height: 80px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                        @foreach (Item.Tag tag in Enum.GetValues<Item.Tag>())
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-success" style="width: 100%;">Create Item</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            var input = document.getElementById("searchInput");
            var filter = input.value.toLowerCase();
            var table = document.getElementById("catalogTable");
            var tbody = table.querySelector("tbody");
            var rows = tbody.querySelectorAll("tr");

            rows.forEach(row => {
                var text = row.textContent.toLowerCase();
                if (text.indexOf(filter) > -1) {
                    row.setAttribute("data-filtered", "false");
                } else {
                    row.setAttribute("data-filtered", "true");
                }
            });
            table.dispatchEvent(new Event("filterRefreshed"));
        }

        function toggleItemTypeFields(form) {
            var select = form.querySelector('[name="itemType"]');
            var itemType = select ? select.value : 'Product';
            var productOnlyFields = form.querySelectorAll('.product-only-field');
            productOnlyFields.forEach(function(el) {
                if (itemType === 'Product') {
                    el.style.display = 'block';
                } else {
                    el.style.display = 'none';
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            var addForm = document.getElementById("createItemForm");
            if (addForm) {
                toggleItemTypeFields(addForm);
            }
            
            // Initialize Common Table helper
            initCommonTable(document.getElementById("catalogTable"));
        });
    </script>
}

