@page
@model EZBM.DesktopClient.Pages.InventoryModel
@using EZBM.Core.Entities
@using EZBM.DesktopClient.Helpers
@{
    ViewData["Title"] = "Inventory";
    bool isEditing = Model.EditingItem is not null;
}

<h2>Inventory</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: #fff5f5; color: #e53e3e; border: 1px solid #fed7d7; padding: 12px; margin-bottom: 20px;">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background-color: #f0fff4; color: #38a169; border: 1px solid #c6f6d5; padding: 12px; margin-bottom: 20px;">
        <strong>Success:</strong> @Model.SuccessMessage
    </div>
}

<div style="display: flex; gap: 40px; align-items: flex-start; flex-wrap: wrap;">
    <!-- Catalog Table Section -->
    <div style="flex-grow: 1; min-width: 600px;">
        <h3>Products & Services</h3>

        <!-- Search bar & Add Item trigger button -->
        <div
            style="margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap;">
            <div>
                <label for="searchInput" style="font-weight: bold; margin-right: 10px;">Search:</label>
                <input type="text" id="searchInput" placeholder="Samsung Galaxy S21 Ultra..."
                       style="width: 300px; padding: 6px; border: 1px solid #cbd5e0;" onkeyup="filterTable()" />
            </div>
            <button type="button" class="btn btn-primary" onclick="openAddModal()">+ Add New Item</button>
        </div>

        <table border="1" cellpadding="5" cellspacing="0" id="catalogTable" data-common-table="true"
               style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #eee;">
                    <th data-hide-default="true">ID</th>
                    <th>Image</th>
                    <th>Brand</th>
                    <th>Name</th>
                    <th data-hide-default="true">Type</th>
                    <th>Description</th>
                    <th data-hide-default="true">For Sale?</th>
                    <th data-numeric="true">Cost Price</th>
                    <th data-numeric="true">Sale Price</th>
                    <th>Stock Level</th>
                    <th data-numeric="true" data-hide-default="true">Threshold %</th>
                    <th data-date="true" data-hide-default="true">Expiration</th>
                    <th data-hide-default="true">Tags</th>
                    <th data-no-sort="true">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    bool isLowStock = false;
                    if (item is Product prod)
                    {
                        isLowStock = prod.Quantity != -1f && prod.Quantity < prod.TargetStock *
                prod.LowStockThresholdPercentage;
                    }
                    <tr style="@(isLowStock ? "background-color: #fff5f5; color: #c53030;" : "")">
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="max-height: 40px; max-width: 40px; object-fit: contain;" />
                            }
                            else
                            {
                                <span style="color: #a0aec0; font-size: 0.9em;">No Image</span>
                            }
                        </td>
                        <td>@item.Brand</td>
                        <td class="search-name"><strong>@item.Name</strong></td>
                        <td>@(item is Service ? "Service" : "Product")</td>
                        <td>@item.Description</td>
                        <td>@(item.IsForSale ? "Yes" : "No")</td>
                        <td>@StateHelper.FormatCurrency(item.Cost)</td>
                        <td>@StateHelper.FormatCurrency(item.SalePrice)</td>
                        <td>
                            <strong>@StateHelper.FormatQuantity(item.Quantity, item.UnitOfMeasurement, item is Product p &&
                                                            p.Quantity != -1f ? p.TargetStock : (float?)null)</strong>
                            </td>
                            <td>@(item is Product pThresh ? $"{(pThresh.LowStockThresholdPercentage * 100):F0}%" : "N/A")</td>
                            <td>@StateHelper.FormatDate(item.ExpirationDate, HttpContext)</td>
                            <td>@string.Join(", ", item.Tags)</td>
                            <td>
                                <div class="action-buttons">
                                    <a href="/Inventory?action=edit&id=@item.Id" class="btn"
                                       style="padding: 2px 6px; font-size: 0.85em;">Edit</a>
                                    <form method="post" asp-page-handler="Delete" style="display: inline;"
                                          onsubmit="return confirm('Are you sure you want to delete this item?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger"
                                                style="padding: 2px 6px; font-size: 0.85em;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add New Item Modal -->
    <div id="addItemModal"
         style="display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
        <div
            style="background-color: white; padding: 25px; width: 450px; border: 1px solid #e2e8f0; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); max-height: 90vh; overflow-y: auto; box-sizing: border-box;">
            <div
                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #edf2f7; padding-bottom: 10px;">
                <h3 style="margin: 0; color: #2b6cb0;">Add New Item</h3>
                <button type="button" onclick="closeAddModal()" class="btn"
                        style="border: none; font-size: 1.5em; padding: 0 5px; cursor: pointer;">&times;</button>
            </div>
            
            <form method="post" asp-page-handler="Create" id="createItemForm">

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Item Type <span style="color: red;">*</span></label>
                    <select name="itemType" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" onchange="toggleItemTypeFields(this.form)">
                        <option value="Product" selected>Product</option>
                        <option value="Service">Service</option>
                    </select>
                    <small style="color: #718096; display: block; margin-top: 3px;">Select whether this is a physical product or a digital service.</small>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="font-weight: bold; display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" name="isForSale" value="true" checked />
                        Available For Sale
                    </label>
                    <small style="color: #718096; display: block; margin-top: 3px;">Turn on to make this item purchasable at cashier checkouts.</small>
                </div>

                <div class="product-only-field" style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Brand</label>
                    <input type="text" name="brand" placeholder="e.g. Samsung, Nestle" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">The manufacturer or brand name of this item.</small>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Name <span style="color: red;">*</span></label>
                    <input type="text" name="name" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">The primary display name of the item.</small>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Description</label>
                    <textarea name="description" style="width: 100%; height: 50px; padding: 6px; border: 1px solid #cbd5e0;"></textarea>
                    <small style="color: #718096; display: block; margin-top: 3px;">A brief description of this item's characteristics.</small>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Image URL</label>
                    <input type="text" name="imageUrl" placeholder="https://example.com/image.jpg" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">A web link to a picture of the item.</small>
                </div>

                <div class="product-only-field" style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Unit of Measurement</label>
                    <select name="unitOfMeasurement" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;">
                        @foreach (Item.Unit unit in Enum.GetValues<Item.Unit>())
                        {
                            <option value="@unit">@unit</option>
                        }
                    </select>
                    <small style="color: #718096; display: block; margin-top: 3px;">The standard unit used to measure this item's stock.</small>
                </div>

                <div class="product-only-field" style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">How much stock of this item do we have? <span style="color: red;">*</span></label>
                    <input type="number" step="0.01" min="-1" name="quantity" value="0" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">The current amount of this item in inventory.</small>
                </div>

                <div class="product-only-field" style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">How much stock should we aim for?</label>
                    <input type="number" step="0.01" min="0" name="targetStock" value="0" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">The ideal stock level we want to maintain in the store.</small>
                </div>

                <div class="product-only-field" style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">How much of the target quantity is considered low stock?</label>
                    <input type="number" step="0.01" min="0" max="1" name="lowStockThresholdPercentage" value="0.20" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">Enter a decimal fraction representing the low stock threshold (e.g. 0.20 for 20%).</small>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">How much did YOU pay for each (1) unit? (@StateHelper.GetCurrencySymbol())</label>
                    <input type="number" step="0.01" min="0" name="cost" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">The cost spent to purchase or produce this item.</small>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">How much should your CUSTOMER pay for each (1) unit? (@StateHelper.GetCurrencySymbol())</label>
                    <input type="number" step="0.01" min="0" name="salePrice" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">The price customers pay to buy this item.</small>
                </div>

                <div class="product-only-field" style="margin-bottom: 12px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Expiration Date</label>
                    <input type="date" name="expirationDate" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                    <small style="color: #718096; display: block; margin-top: 3px;">The expiration date of the item (leave blank if not applicable).</small>
                </div>

                <div class="tags-input-container" style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Tags</label>
                    <div id="addTagsBubbles" style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px;"></div>
                    <div style="display: flex; gap: 8px;">
                        <select id="addTagDropdown" style="flex-grow: 1; padding: 6px; border: 1px solid #cbd5e0;">
                            <option value="">-- Select a tag --</option>
                            @foreach (var tag in Item.DefaultTags)
                            {
                                <option value="@tag">@tag</option>
                            }
                        </select>
                        <button type="button" onclick="addTagFromDropdown('add')" class="btn" style="padding: 6px 12px;">Add</button>
                    </div>
                    <div id="addHiddenTagsInputs"></div>
                    <small style="color: #718096; display: block; margin-top: 3px;">Assign labels to this item for easier organization.</small>
                </div>

                <button type="submit" class="btn btn-success" style="width: 100%;">Create Item</button>
            </form>
                                </div>
                            </div>

                            @if (isEditing)
                            {
                                @section RightSidebar {
                                    <div style="width: 100%; box-sizing: border-box;">
                                        <h3 style="margin-top:0;">Edit Item (ID: @Model.EditingItem!.Id)</h3>
                                        
                                        <form method="post" asp-page-handler="Update" id="updateItemForm">
                                            <input type="hidden" name="id" value="@Model.EditingItem.Id" />

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Item Type</label>
                                                <input type="hidden" name="itemType" value="@(Model.EditingItem is Service ? "Service" : "Product")" />
                                                <strong>@(Model.EditingItem is Service ? "Service" : "Product")</strong>
                                                <small style="color: #718096; display: block; margin-top: 3px;">The fundamental classification of this inventory item.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Brand</label>
                                                <input type="text" name="brand" value="@Model.EditingItem.Brand" placeholder="e.g. Samsung, Nestle"
                                                       style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                <small style="color: #718096; display: block; margin-top: 3px;">The manufacturer or brand name of this item.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Name <span style="color: red;">*</span></label>
                                                <input type="text" name="name" value="@Model.EditingItem.Name" required
                                                       style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                <small style="color: #718096; display: block; margin-top: 3px;">The primary display name of the item.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Description</label>
                                                <textarea name="description"
                                                          style="width: 100%; height: 50px; padding: 6px; border: 1px solid #cbd5e0;">@Model.EditingItem.Description</textarea>
                                                <small style="color: #718096; display: block; margin-top: 3px;">A brief description of this item's characteristics.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Image URL</label>
                                                <input type="text" name="imageUrl" value="@Model.EditingItem.ImageUrl"
                                                       placeholder="https://example.com/image.jpg"
                                                       style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                <small style="color: #718096; display: block; margin-top: 3px;">A web link to a picture of the item.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="font-weight: bold; display: flex; align-items: center; gap: 8px;">
                                                    <input type="checkbox" name="isForSale" value="true" @(Model.EditingItem.IsForSale ? "checked" : "") />
                                                    Available For Sale
                                                </label>
                                                <small style="color: #718096; display: block; margin-top: 3px;">Turn on to make this item purchasable at cashier checkouts.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Cost Price (@StateHelper.GetCurrencySymbol())</label>
                                                <input type="number" step="0.01" min="0" name="cost" value="@Model.EditingItem.Cost"
                                                       style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                <small style="color: #718096; display: block; margin-top: 3px;">The cost spent to purchase or produce this item.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Sale Price (@StateHelper.GetCurrencySymbol())</label>
                                                <input type="number" step="0.01" min="0" name="salePrice" value="@Model.EditingItem.SalePrice"
                                                       style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                <small style="color: #718096; display: block; margin-top: 3px;">The price customers pay to buy this item.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Unit of Measurement</label>
                                                <select name="unitOfMeasurement" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;">
                                                    @foreach (Item.Unit unit in Enum.GetValues<Item.Unit>())
                                                    {
                                                        bool isSel = Model.EditingItem.UnitOfMeasurement == unit;
                                                        if (isSel)
                                                        {
                                                            <option value="@unit" selected>@unit</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@unit">@unit</option>
                                                        }
                                                    }
                                                </select>
                                                <small style="color: #718096; display: block; margin-top: 3px;">The standard unit used to measure this item's stock.</small>
                                            </div>

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Stock Quantity <span style="color: red;">*</span></label>
                                                <input type="number" step="0.01" min="-1" name="quantity" value="@Model.EditingItem.Quantity" required
                                                       style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                <small style="color: #718096; display: block; margin-top: 3px;">The current amount of this item in inventory.</small>
                                            </div>

                                            @if (Model.EditingItem is Product prodEdit)
                                            {
                                                <div class="product-only-field" style="margin-bottom: 12px;">
                                                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">How much stock should we aim for?</label>
                                                    <input type="number" step="0.01" min="0" name="targetStock" value="@prodEdit.TargetStock"
                                                           style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                    <small style="color: #718096; display: block; margin-top: 3px;">The ideal stock level we want to maintain in the store.</small>
                                                </div>

                                                <div class="product-only-field" style="margin-bottom: 12px;">
                                                    <label style="display: block; font-weight: bold; margin-bottom: 4px;">How much of the target quantity is considered low stock?</label>
                                                    <input type="number" step="0.01" min="0" max="1" name="lowStockThresholdPercentage"
                                                           value="@prodEdit.LowStockThresholdPercentage"
                                                           style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                    <small style="color: #718096; display: block; margin-top: 3px;">Enter a decimal fraction representing the low stock threshold (e.g. 0.20 for 20%).</small>
                                                </div>
                                            }

                                            <div style="margin-bottom: 12px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Expiration Date</label>
                                                <input type="date" name="expirationDate" value="@(Model.EditingItem.ExpirationDate?.ToString("yyyy-MM-dd"))"
                                                       style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" />
                                                <small style="color: #718096; display: block; margin-top: 3px;">The expiration date of the item (leave blank if not applicable).</small>
                                            </div>

                                            <div class="tags-input-container" style="margin-bottom: 15px;">
                                                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Tags</label>
                                                <div id="editTagsBubbles" style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px;"></div>
                                                <div style="display: flex; gap: 8px;">
                                                    <select id="editTagDropdown" style="flex-grow: 1; padding: 6px; border: 1px solid #cbd5e0;">
                                                        <option value="">-- Select a tag --</option>
                                                        @foreach (var tag in Item.DefaultTags)
                                                        {
                                                            <option value="@tag">@tag</option>
                                                        }
                                                    </select>
                                                    <button type="button" onclick="addTagFromDropdown('edit')" class="btn"
                                                            style="padding: 6px 12px;">Add</button>
                                                </div>
                                                <div id="editHiddenTagsInputs"></div>
                                                <small style="color: #718096; display: block; margin-top: 3px;">Assign labels to this item for easier organization.</small>
                                            </div>

                                            <div style="display: flex; gap: 10px;">
                                                <button type="submit" class="btn btn-primary" style="flex: 1;">Update Item</button>
                                                <a href="/Inventory" class="btn" style="flex: 1; text-align: center;">Cancel</a>
                                            </div>
                                        </form>
                                                        </div>
                                                    }
                                                }

                                                @section Scripts {
                                                    <script>
                                                        function filterTable() {
                                                            var input = document.getElementById("searchInput");
                                                            var filter = input.value.toLowerCase();
                                                            var table = document.getElementById("catalogTable");
                                                            var tbody = table.querySelector("tbody");
                                                            var rows = tbody.querySelectorAll("tr");

                                                            rows.forEach(row => {
                                                                var text = row.textContent.toLowerCase();
                                                                if (text.indexOf(filter) > -1) {
                                                                    row.setAttribute("data-filtered", "false");
                                                                } else {
                                                                    row.setAttribute("data-filtered", "true");
                                                                }
                                                            });
                                                            table.dispatchEvent(new Event("filterRefreshed"));
                                                        }

                                                        function toggleItemTypeFields(form) {
                                                            var select = form.querySelector('[name="itemType"]');
                                                            var itemType = select ? select.value : 'Product';
                                                            var productOnlyFields = form.querySelectorAll('.product-only-field');
                                                            productOnlyFields.forEach(function (el) {
                                                                if (itemType === 'Product') {
                                                                    el.style.display = 'block';
                                                                } else {
                                                                    el.style.display = 'none';
                                                                }
                                                            });
                                                        }

                                                        function openAddModal() {
                                                            document.getElementById("addItemModal").style.display = "flex";
                                                            const addForm = document.getElementById("createItemForm");
                                                            if (addForm) {
                                                                toggleItemTypeFields(addForm);
                                                                if (addForm._wizardComponent) {
                                                                    addForm._wizardComponent.currentStep = 0;
                                                                    addForm._wizardComponent.showStep();
                                                                }
                                                            }
                                                        }

                                                        function closeAddModal() {
                                                            document.getElementById("addItemModal").style.display = "none";
                                                        }

                                                        const tagsState = {
                                                            add: [],
                                                            edit: []
                                                        };

                                                        function renderTags(prefix) {
                                                            const bubblesContainer = document.getElementById(prefix + "TagsBubbles");
                                                            const hiddenContainer = document.getElementById(prefix + "HiddenTagsInputs");
                                                            if (!bubblesContainer || !hiddenContainer) return;

                                                            bubblesContainer.innerHTML = "";
                                                            hiddenContainer.innerHTML = "";

                                                            tagsState[prefix].forEach(tag => {
                                                                const bubble = document.createElement("span");
                                                                bubble.style.cssText = "background: #ebf8ff; color: #2b6cb0; padding: 4px 10px; border-radius: 9999px; display: inline-flex; align-items: center; gap: 6px; font-size: 0.85em; font-weight: bold; border: 1px solid #bee3f8; margin: 2px;";
                                                                bubble.innerHTML = `${tag} <span onclick="removeTag('${prefix}', '${tag}')" style="cursor: pointer; color: #9b2c2c; font-weight: bold; font-size: 1.1em;">&times;</span>`;
                                                                bubblesContainer.appendChild(bubble);

                                                                const hiddenInput = document.createElement("input");
                                                                hiddenInput.type = "hidden";
                                                                hiddenInput.name = "tags";
                                                                hiddenInput.value = tag;
                                                                hiddenContainer.appendChild(hiddenInput);
                                                            });

                                                            // Trigger change event to revalidate step
                                                            hiddenContainer.dispatchEvent(new Event("change", { bubbles: true }));
                                                        }

                                                        function addTagFromDropdown(prefix) {
                                                            const dropdown = document.getElementById(prefix + "TagDropdown");
                                                            if (!dropdown) return;
                                                            const tag = dropdown.value;
                                                            if (tag && !tagsState[prefix].includes(tag)) {
                                                                tagsState[prefix].push(tag);
                                                                renderTags(prefix);
                                                            }
                                                            dropdown.value = "";
                                                        }

                                                        function removeTag(prefix, tag) {
                                                            const idx = tagsState[prefix].indexOf(tag);
                                                            if (idx > -1) {
                                                                tagsState[prefix].splice(idx, 1);
                                                                renderTags(prefix);
                                                            }
                                                        }

                                                        document.addEventListener("DOMContentLoaded", function () {
                                                            var addForm = document.getElementById("createItemForm");
                                                            if (addForm) {
                                                                toggleItemTypeFields(addForm);

                                                                const addItemSteps = [
                                                                     { fields: ['itemType'], question: 'What type of item is it <span style="color: red;">*</span>?', summaryLabel: 'Item Type', required: true },
                                                                     { fields: ['isForSale'], question: 'Should this item be available for sale?', summaryLabel: 'Available For Sale', required: false },
                                                                     { fields: ['brand'], question: 'What brand is it from? (e.g. "Samsung", "Nestle")', summaryLabel: 'Brand', required: false, condition: (form) => form.querySelector('[name="itemType"]').value === 'Product' },
                                                                     { fields: ['name'], question: 'What is the name of the item <span style="color: red;">*</span>?', summaryLabel: 'Name', required: true },
                                                                     { fields: ['description'], question: 'Describe this item.', summaryLabel: 'Description', required: false },
                                                                     { fields: ['imageUrl'], question: 'What is the image URL of this item?', summaryLabel: 'Image URL', required: false },
                                                                     { fields: ['unitOfMeasurement'], question: 'What is the unit of measurement?', summaryLabel: 'Unit of Measurement', required: true, condition: (form) => form.querySelector('[name="itemType"]').value === 'Product' },
                                                                     { fields: ['quantity'], question: 'How much stock of this item do we have? <span style="color: red;">*</span>', summaryLabel: 'Stock Quantity', required: true, condition: (form) => form.querySelector('[name="itemType"]').value === 'Product' && form.querySelector('[name="unitOfMeasurement"]').value !== 'Unlimited' },
                                                                     { fields: ['targetStock'], question: 'How much stock should we aim for?', summaryLabel: 'Target Stock', required: false, condition: (form) => form.querySelector('[name="itemType"]').value === 'Product' && form.querySelector('[name="unitOfMeasurement"]').value !== 'Unlimited' },
                                                                     { fields: ['lowStockThresholdPercentage'], question: 'How much of the target quantity is considered low stock?', summaryLabel: 'Low Stock Threshold', required: false, condition: (form) => form.querySelector('[name="itemType"]').value === 'Product' && form.querySelector('[name="unitOfMeasurement"]').value !== 'Unlimited' },
                                                                     { fields: ['cost'], question: 'How much did YOU pay for each (1) unit?', summaryLabel: 'Cost Price', required: false },
                                                                     { fields: ['salePrice'], question: 'How much should your CUSTOMER pay for each (1) unit?', summaryLabel: 'Sale Price', required: false },
                                                                     { fields: ['expirationDate'], question: 'What is the expiration date?', summaryLabel: 'Expiration Date', required: false, condition: (form) => form.querySelector('[name="itemType"]').value === 'Product' },
                                                                     { fields: ['.tags-input-container'], question: 'Select tags for this item:', summaryLabel: 'Tags', required: false },
                                                                     { isSummary: true, question: 'Review and Finish', fields: [] }
                                                                 ];

                                                                new FormWizardComponent("createItemForm", addItemSteps);
                                                            }

                                                            @if (isEditing)
                                                                {
                                                                        @foreach (var tag in Model.EditingItem!.Tags)
                                                                    {
                                                                        <text>tagsState.edit.push("@tag");</text>
                                                                }
                                                                    <text>renderTags("edit");</text>
                                                            }

                                                                // Initialize Common Table helper
                                                                initCommonTable(document.getElementById("catalogTable"));
                                                        });
                                                    </script>
                                                }
