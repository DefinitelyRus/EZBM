@page
@model EZBM.DesktopClient.Pages.SetupModel
@{
    ViewData["Title"] = "System Onboarding";
}

<h2>System Onboarding</h2>
<p>Initial system configuration and administrator staff registration.</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: #fff5f5; color: #e53e3e; border: 1px solid #fed7d7; padding: 12px; margin-bottom: 20px;">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

<div id="setupModal" style="display: flex; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
    <div style="background-color: white; padding: 25px; width: 480px; border: 1px solid #e2e8f0; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); max-height: 90vh; overflow-y: auto; box-sizing: border-box;">
        <div style="margin-bottom: 20px; border-bottom: 2px solid #edf2f7; padding-bottom: 10px;">
            <h3 style="margin: 0; color: #2b6cb0;">EZBM System Onboarding</h3>
            <small style="color: #718096; display: block; margin-top: 4px;">Welcome! Please configure your administrator account and store settings to get started.</small>
        </div>

        <form method="post" id="setupForm">
            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Admin Username <span style="color: red;">*</span></label>
                <input type="text" name="AdminUsername" value="@Model.AdminUsername" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" placeholder="e.g. admin" />
                <small style="color: #718096; display: block; margin-top: 3px;">The unique username used to log in as administrator.</small>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Admin Password <span style="color: red;">*</span></label>
                <input type="password" name="AdminPassword" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" placeholder="••••••••" />
                <small style="color: #718096; display: block; margin-top: 3px;">The secure password for the administrator account.</small>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">First Name</label>
                <input type="text" name="AdminFirstName" value="@Model.AdminFirstName" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" placeholder="Juan" />
                <small style="color: #718096; display: block; margin-top: 3px;">The administrator's first name.</small>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Last Name</label>
                <input type="text" name="AdminLastName" value="@Model.AdminLastName" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" placeholder="Dela Cruz" />
                <small style="color: #718096; display: block; margin-top: 3px;">The administrator's family or last name.</small>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Email Address</label>
                <input type="email" name="AdminEmail" value="@Model.AdminEmail" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" placeholder="admin@mybusiness.com" />
                <small style="color: #718096; display: block; margin-top: 3px;">Primary email address for system notifications.</small>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Store Name <span style="color: red;">*</span></label>
                <input type="text" name="StoreName" value="@Model.StoreName" required style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;" placeholder="e.g. PH Pet Supplies" />
                <small style="color: #718096; display: block; margin-top: 3px;">The business or store display name.</small>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Local Currency</label>
                <select name="Currency" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0;">
                    <option value="PHP">PHP - Philippine Peso (₱)</option>
                    <option value="USD">USD - United States Dollar ($)</option>
                    <option value="SGD">SGD - Singapore Dollar (S$)</option>
                    <option value="EUR">EUR - Euro (€)</option>
                </select>
                <small style="color: #718096; display: block; margin-top: 3px;">Primary currency used for transactions.</small>
            </div>

            <button type="submit" class="btn btn-success" style="width: 100%; margin-top: 10px;">Complete Setup & Register User</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const setupForm = document.getElementById("setupForm");
            if (setupForm) {
                const setupSteps = [
                    { fields: ['AdminUsername', 'AdminPassword'], question: 'Set initial staff username and password <span style="color: red;">*</span>', required: true },
                    { fields: ['AdminFirstName', 'AdminLastName', 'AdminEmail'], question: 'Administrator details', required: false },
                    { fields: ['StoreName', 'Currency'], question: 'Configure store name and currency <span style="color: red;">*</span>', required: true },
                    { isSummary: true, question: 'Review and Complete Setup', fields: [] }
                ];
                new FormWizardComponent("setupForm", setupSteps, { hideModeToggle: true });
            }
        });
    </script>
}
