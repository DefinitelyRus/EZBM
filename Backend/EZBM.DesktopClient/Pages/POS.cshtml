@page
@model EZBM.DesktopClient.Pages.POSModel
@using EZBM.Core.Entities
@{
    ViewData["Title"] = "POS Checkout";
}

<h2>Page 4: Point-of-Sale (POS) Checkout</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: #ffcccc; color: #cc0000; border: 1px solid #cc0000; padding: 10px; margin-bottom: 20px;">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background-color: #ccffcc; color: #008800; border: 1px solid #008800; padding: 10px; margin-bottom: 20px;">
        <strong>Success:</strong> @Model.SuccessMessage
    </div>
}

@if (Model.ActiveStaff is null)
{
    <div style="background-color: #ffffcc; border: 1px solid #bbbb00; padding: 15px; margin-bottom: 20px;">
        <strong>Warning:</strong> You must be <a href="/Login">logged in as an employee</a> to process checkouts. Sales will be recorded under your active session.
    </div>
}

<div style="display: flex; gap: 40px; align-items: flex-start;">
    <!-- Catalog Side (Left) -->
    <div style="flex: 1; border: 1px solid #000; padding: 15px;">
        <h3>Available Items for Sale</h3>
        
        <div style="margin-bottom: 10px; display: flex; gap: 10px;">
            <input type="text" id="posSearchInput" placeholder="Search item name..." onkeyup="filterPosCatalog()" style="width: 250px; padding: 5px;" />
            <span style="color: #666; font-size: 0.9em; align-self: center;">(Or scan barcode)</span>
        </div>

        <table border="1" cellpadding="5" cellspacing="0" id="posCatalogTable" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #eee;">
                    <th>Name</th>
                    <th>Price</th>
                    <th>Barcode</th>
                    <th>In Stock</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CatalogItems)
                {
                    <tr>
                        <td class="pos-item-name"><strong>@item.Name</strong></td>
                        <td>@((item.SalePrice ?? 0f).ToString("C"))</td>
                        <td><code class="pos-item-barcode">@(item.Barcode ?? "N/A")</code></td>
                        <td>@item.Quantity @item.UnitOfMeasurement</td>
                        <td>
                            @if (item.Quantity > 0 || item.UnitOfMeasurement == Item.Unit.Count)
                            {
                                <button type="button" onclick="addToCart(@item.Id, '@item.Name', @(item.SalePrice ?? 0f))">Add to Cart</button>
                            }
                            else
                            {
                                <span style="color: red;">Out of Stock</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Cart / Checkout Side (Right) -->
    <div style="width: 380px; border: 1px solid #000; padding: 15px; background-color: #fafafa;">
        <h3>Shopping Cart</h3>
        
        <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
            <thead>
                <tr style="background-color: #eee;">
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Rem</th>
                </tr>
            </thead>
            <tbody id="cartTableBody">
                <tr>
                    <td colspan="5" style="text-align: center; color: #888;">Cart is empty</td>
                </tr>
            </tbody>
        </table>

        <div style="font-size: 1.2em; font-weight: bold; margin-bottom: 20px;">
            Total Amount: $<span id="cartTotalText">0.00</span>
        </div>

        <form method="post" id="checkoutForm" asp-page-handler="Checkout" onsubmit="return handleCheckoutSubmit(event);">
            <input type="hidden" name="cartJson" id="cartJsonInput" value="" />
            <input type="hidden" name="totalAmount" id="totalAmountInput" value="0" />
            <input type="hidden" name="splitPaymentsJson" id="splitPaymentsJsonInput" value="" />

            <div style="margin-bottom: 10px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Promo Code:</label>
                <input type="text" name="promoCode" id="promoCodeInput" placeholder="e.g. FREEWEEK" style="width: 100%; padding: 5px; box-sizing: border-box;" />
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Payment Method:</label>
                <select name="paymentMethod" id="paymentMethodSelect" onchange="onPaymentMethodChanged()" style="width: 100%; padding: 5px;">
                    @foreach (Transaction.PayMethod method in Enum.GetValues<Transaction.PayMethod>())
                    {
                        <option value="@method">@method</option>
                    }
                </select>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Transaction Notes:</label>
                <textarea name="notes" placeholder="Optional comments..." style="width: 100%; height: 50px; box-sizing: border-box;"></textarea>
            </div>

            <button type="submit" id="checkoutBtn" disabled style="width: 100%; font-size: 1.1em; font-weight: bold; padding: 8px; background-color: #007bff; color: white; border: none; cursor: pointer;">
                Complete Checkout
            </button>

            <button type="button" onclick="showRfidModal()" style="width: 100%; margin-top: 10px; background-color: #f0ad4e; color: white; font-weight: bold; padding: 8px; border: none; cursor: pointer;">
                Open Cash Drawer (Override)
            </button>
        </form>
    </div>
</div>

<!-- Modal 1: RFID Override Swipe -->
<div id="rfidModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
    <div style="background-color: white; padding: 30px; border-radius: 5px; width: 400px; text-align: center; border: 2px solid #333;">
        <h3>Swipe RFID Access Card</h3>
        <p>Please swipe your Staff RFID card to kick/open the cash drawer.</p>
        <div style="font-size: 4em; margin: 20px 0;">💳</div>
        
        <form method="post" asp-page-handler="OpenRegister">
            <input type="password" name="rfidCardId" id="rfidOverrideInput" placeholder="Card ID scans here..." style="width: 80%; padding: 10px; font-size: 1.2em; text-align: center;" required autocomplete="off" />
            <div style="margin-top: 20px;">
                <button type="button" onclick="closeRfidModal()" style="padding: 10px 20px; font-weight: bold; margin-right: 10px;">Cancel</button>
                <button type="submit" style="padding: 10px 20px; font-weight: bold; background-color: #0275d8; color: white; border: none;">Verify & Open</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 2: Split Payment Editor -->
<div id="splitPaymentModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
    <div style="background-color: white; padding: 25px; border-radius: 5px; width: 450px; border: 2px solid #333;">
        <h3>Split Payment Details</h3>
        <div style="font-size: 1.1em; margin-bottom: 15px;">
            Total Sale Cost: <strong style="color: blue;">$<span id="splitTotalText">0.00</span></strong>
        </div>
        <div style="font-size: 1.1em; margin-bottom: 15px;">
            Balance Remaining: <strong id="splitRemainingText" style="color: red;">$0.00</strong>
        </div>

        <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
            <thead>
                <tr style="background-color: #eee;">
                    <th>Payment Method</th>
                    <th>Amount ($)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Transaction.PayMethod method in Enum.GetValues<Transaction.PayMethod>())
                {
                    if (method != Transaction.PayMethod.Mixed)
                    {
                        <tr>
                            <td><strong>@method</strong></td>
                            <td>
                                <input type="number" step="0.01" min="0" value="0.00" class="split-amount-input" data-method="@method" onchange="calculateSplitRemaining()" onkeyup="calculateSplitRemaining()" style="width: 100%; text-align: right;" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div style="text-align: right;">
            <button type="button" onclick="closeSplitModal()" style="padding: 10px 15px; font-weight: bold; margin-right: 10px;">Cancel</button>
            <button type="button" id="confirmSplitBtn" onclick="confirmSplitPayments()" disabled style="padding: 10px 15px; font-weight: bold; background-color: green; color: white; border: none; cursor: pointer;">Confirm split</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cart = [];
        let catalog = [];

        // Load catalog items in JS context for barcode scanning matching
        @foreach (var item in Model.CatalogItems)
        {
            <text>
            catalog.push({
                id: @item.Id,
                name: '@Html.Raw(item.Name)',
                saleprice: @(item.SalePrice ?? 0f),
                barcode: '@(Html.Raw(item.Barcode ?? ""))',
                description: '@Html.Raw(item.Description ?? "")',
                tags: '@Html.Raw(string.Join(", ", item.Tags))'
            });
            </text>
        }

        // Global key press buffer for barcode / RFID scanning
        let keypressBuffer = "";
        let lastKeypressTime = Date.now();

        window.addEventListener("keydown", function(e) {
            let now = Date.now();
            let delta = now - lastKeypressTime;
            lastKeypressTime = now;

            // Clear buffer if pause is too long (user typing manually is usually slower)
            if (delta > 200) {
                keypressBuffer = "";
            }

            if (e.key === "Enter") {
                let code = keypressBuffer.trim();
                keypressBuffer = "";

                if (code.length > 0) {
                    // 1. If override card swipe modal is open
                    let rfidModal = document.getElementById("rfidModal");
                    if (rfidModal.style.display === "flex") {
                        let input = document.getElementById("rfidOverrideInput");
                        input.value = code;
                        input.form.submit();
                        e.preventDefault();
                        return;
                    }

                    // 2. Normal barcode check
                    let item = catalog.find(i => i.barcode === code);
                    if (item) {
                        addToCart(item.id, item.name, item.saleprice);
                        e.preventDefault();
                        alert("Scanned: " + item.name + " (" + code + ")");
                    }
                }
            } else if (e.key.length === 1) {
                keypressBuffer += e.key;
            }
        });

        function filterPosCatalog() {
            let input = document.getElementById("posSearchInput");
            let filter = input.value.toLowerCase();
            let table = document.getElementById("posCatalogTable");
            let rows = table.getElementsByTagName("tr");

            for (let i = 1; i < rows.length; i++) {
                let item = catalog[i - 1];
                if (item) {
                    let combinedText = (item.id + " " + item.name + " " + item.barcode + " " + item.description + " " + item.tags).toLowerCase();
                    if (combinedText.indexOf(filter) > -1) {
                        rows[i].style.display = "";
                    } else {
                        rows[i].style.display = "none";
                    }
                }
            }
        }

        function addToCart(itemId, name, price) {
            let existing = cart.find(i => i.itemId === itemId);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({
                    itemId: itemId,
                    name: name,
                    quantity: 1,
                    unitPrice: price
                });
            }
            renderCart();
        }

        function updateQuantity(itemId, qty) {
            let item = cart.find(i => i.itemId === itemId);
            if (item) {
                item.quantity = parseFloat(qty);
                if (item.quantity <= 0 || isNaN(item.quantity)) {
                    removeFromCart(itemId);
                    return;
                }
            }
            renderCart();
        }

        function removeFromCart(itemId) {
            cart = cart.filter(i => i.itemId !== itemId);
            renderCart();
        }

        function getCartTotal() {
            let total = 0;
            cart.forEach(item => {
                total += item.quantity * item.unitPrice;
            });
            return total;
        }

        function renderCart() {
            let tbody = document.getElementById("cartTableBody");
            let totalText = document.getElementById("cartTotalText");
            let cartJsonInput = document.getElementById("cartJsonInput");
            let totalAmountInput = document.getElementById("totalAmountInput");
            let checkoutBtn = document.getElementById("checkoutBtn");

            if (cart.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #888;">Cart is empty</td></tr>';
                totalText.innerText = "0.00";
                cartJsonInput.value = "";
                totalAmountInput.value = "0";
                checkoutBtn.disabled = true;
                return;
            }

            let html = "";
            let grandTotal = getCartTotal();

            cart.forEach(item => {
                let rowTotal = item.quantity * item.unitPrice;

                html += `<tr>
                    <td><strong>${item.name}</strong></td>
                    <td>
                        <input type="number" step="0.1" min="0.1" value="${item.quantity}" onchange="updateQuantity(${item.itemId}, this.value)" style="width: 50px;" />
                    </td>
                    <td>$${item.unitPrice.toFixed(2)}</td>
                    <td>$${rowTotal.toFixed(2)}</td>
                    <td>
                        <button type="button" onclick="removeFromCart(${item.itemId})" style="color: red; border: none; background: none; cursor: pointer;">X</button>
                    </td>
                </tr>`;
            });

            tbody.innerHTML = html;
            totalText.innerText = grandTotal.toFixed(2);
            totalAmountInput.value = grandTotal.toFixed(4);
            
            // Format for backend: List<CartItemDto> -> [{itemId, quantity, unitPrice}, ...]
            let submitData = cart.map(i => ({
                itemId: i.itemId,
                quantity: i.quantity,
                unitPrice: i.unitPrice
            }));
            cartJsonInput.value = JSON.stringify(submitData);
            
            checkoutBtn.disabled = false;
        }

        // Hardware simulation modals logic
        function showRfidModal() {
            let modal = document.getElementById("rfidModal");
            modal.style.display = "flex";
            document.getElementById("rfidOverrideInput").focus();
        }

        function closeRfidModal() {
            document.getElementById("rfidModal").style.display = "none";
        }

        function onPaymentMethodChanged() {
            let method = document.getElementById("paymentMethodSelect").value;
            let checkoutBtn = document.getElementById("checkoutBtn");
            if (method === "Mixed") {
                checkoutBtn.innerText = "Setup Split Payments...";
            } else {
                checkoutBtn.innerText = "Complete Checkout";
            }
        }

        // Split payments modal logic
        function showSplitPaymentModal() {
            let total = getCartTotal();
            document.getElementById("splitTotalText").innerText = total.toFixed(2);
            calculateSplitRemaining();
            document.getElementById("splitPaymentModal").style.display = "flex";
        }

        function closeSplitModal() {
            document.getElementById("splitPaymentModal").style.display = "none";
        }

        function calculateSplitRemaining() {
            let total = getCartTotal();
            let inputs = document.querySelectorAll(".split-amount-input");
            let sum = 0;
            inputs.forEach(input => {
                let val = parseFloat(input.value);
                if (!isNaN(val) && val > 0) {
                    sum += val;
                }
            });

            let remaining = total - sum;
            let remainingText = document.getElementById("splitRemainingText");
            let confirmBtn = document.getElementById("confirmSplitBtn");

            remainingText.innerText = "$" + remaining.toFixed(2);

            if (Math.abs(remaining) < 0.01) {
                remainingText.style.color = "green";
                confirmBtn.disabled = false;
            } else {
                remainingText.style.color = "red";
                confirmBtn.disabled = true;
            }
        }

        function confirmSplitPayments() {
            let inputs = document.querySelectorAll(".split-amount-input");
            let splits = [];
            inputs.forEach(input => {
                let amount = parseFloat(input.value);
                if (!isNaN(amount) && amount > 0) {
                    splits.push({
                        paymentMethod: input.getAttribute("data-method"),
                        amount: amount
                    });
                }
            });

            document.getElementById("splitPaymentsJsonInput").value = JSON.stringify(splits);
            closeSplitModal();
            
            // Re-submit the form
            document.getElementById("checkoutForm").submit();
        }

        function handleCheckoutSubmit(event) {
            let method = document.getElementById("paymentMethodSelect").value;
            if (method === "Mixed") {
                event.preventDefault();
                showSplitPaymentModal();
                return false;
            }
            
            let total = document.getElementById("cartTotalText").innerText;
            return confirm("Confirm total checkout amount of $" + total + "?");
        }
    </script>
}
