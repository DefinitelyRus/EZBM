@page
@model EZBM.DesktopClient.Pages.POSModel
@using EZBM.Core.Entities
@using EZBM.DesktopClient.Helpers
@{
    ViewData["Title"] = "POS Checkout";
}

<h2>POS Checkout Terminal</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: #fff5f5; color: #e53e3e; border: 1px solid #fed7d7; padding: 12px; margin-bottom: 20px; border-radius: 6px;">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background-color: #f0fff4; color: #38a169; border: 1px solid #c6f6d5; padding: 12px; margin-bottom: 20px; border-radius: 6px;">
        <strong>Success:</strong> @Model.SuccessMessage
    </div>
}

@if (Model.ActiveStaff is null)
{
    <div style="background-color: #fffaf0; border: 1px solid #feebc8; padding: 15px; margin-bottom: 20px; border-radius: 6px; color: #c05621;">
        <strong>Warning:</strong> You must be <a href="/Login">logged in as an employee</a> to process checkouts. Sales will be recorded under your active session.
    </div>
}

<div style="display: flex; gap: 40px; align-items: flex-start; flex-wrap: wrap;">
    <!-- Catalog Side (Left) -->
    <div style="flex: 1; min-width: 500px; background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <h3>Available Items for Sale</h3>
        
        <div style="margin-bottom: 15px; display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
            <div>
                <label for="posSearchInput" style="font-weight: bold; margin-right: 5px;">Search Catalog:</label>
                <input type="text" id="posSearchInput" placeholder="Filter item name..." onkeyup="filterPosCatalog()" style="width: 200px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
            </div>
            <div style="display: flex; align-items: center; gap: 6px;">
                <label for="manualBarcodeInput" style="font-weight: bold;">Manual Barcode:</label>
                <input type="text" id="manualBarcodeInput" placeholder="Type barcode..." onkeypress="handleManualBarcodeKeyPress(event)" style="width: 150px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                <button type="button" onclick="lookupManualBarcode()" class="btn btn-secondary" style="padding: 6px 12px;">Lookup</button>
            </div>
        </div>

        <table border="1" cellpadding="5" cellspacing="0" id="posCatalogTable" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #eee;">
                    <th>Name</th>
                    <th data-numeric="true">Price</th>
                    <th>Barcode</th>
                    <th>In Stock</th>
                    <th data-no-sort="true">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CatalogItems)
                {
                    <tr>
                        <td class="pos-item-name"><strong>@item.Name</strong></td>
                        <td>@StateHelper.FormatCurrency(item.SalePrice ?? 0f)</td>
                        <td><code class="pos-item-barcode">@(item.Barcode ?? "N/A")</code></td>
                        <td>@item.Quantity @item.UnitOfMeasurement</td>
                        <td>
                            @if (item.Quantity > 0 || item.UnitOfMeasurement == Item.Unit.Count)
                            {
                                <button type="button" class="btn btn-primary" onclick="addToCart(@item.Id, '@item.Name', @(item.SalePrice ?? 0f))" style="padding: 4px 10px; font-size: 0.85em;">Add</button>
                            }
                            else
                            {
                                <span style="color: #e53e3e; font-weight: bold; font-size: 0.9em;">Out of Stock</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Cart / Checkout Side (Right) -->
    <div style="width: 400px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; background-color: white; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); box-sizing: border-box;">
        <h3>Shopping Cart</h3>
        
        <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <thead>
                <tr style="background-color: #eee;">
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th data-no-sort="true">Rem</th>
                </tr>
            </thead>
            <tbody id="cartTableBody">
                <tr>
                    <td colspan="5" style="text-align: center; color: #a0aec0; padding: 15px;">Cart is empty</td>
                </tr>
            </tbody>
        </table>

        <div style="font-size: 1.3em; font-weight: bold; margin-bottom: 20px; text-align: right; border-top: 2px solid #edf2f7; padding-top: 10px;">
            Total: <span id="cartTotalTextLabel">₱0.00</span>
        </div>

        <form method="post" id="checkoutForm" asp-page-handler="Checkout" onsubmit="return handleCheckoutSubmit(event);">
            <input type="hidden" name="cartJson" id="cartJsonInput" value="" />
            <input type="hidden" name="totalAmount" id="totalAmountInput" value="0" />
            <input type="hidden" name="splitPaymentsJson" id="splitPaymentsJsonInput" value="" />

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Promo Code:</label>
                <input type="text" name="promoCode" id="promoCodeInput" placeholder="e.g. SAVE10" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px; box-sizing: border-box;" />
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Payment Method:</label>
                <select name="paymentMethod" id="paymentMethodSelect" onchange="onPaymentMethodChanged()" style="width: 100%; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px;">
                    @foreach (Transaction.PayMethod method in Enum.GetValues<Transaction.PayMethod>())
                    {
                        <option value="@method">@method</option>
                    }
                </select>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 4px;">Transaction Notes:</label>
                <textarea name="notes" placeholder="Optional notes/comments..." style="width: 100%; height: 50px; padding: 6px; border: 1px solid #cbd5e0; border-radius: 4px; box-sizing: border-box;"></textarea>
            </div>

            <button type="submit" id="checkoutBtn" class="btn btn-success" disabled style="width: 100%; padding: 10px; font-size: 1.05em;">
                Complete Checkout
            </button>

            <button type="button" class="btn btn-secondary" onclick="showRfidModal()" style="width: 100%; margin-top: 10px; padding: 10px; font-size: 1.05em;">
                Open Cash Drawer (Override)
            </button>
        </form>
    </div>
</div>

<!-- Modal 1: RFID Override Swipe -->
<div id="rfidModal" style="display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
    <div style="background-color: white; padding: 30px; border-radius: 8px; width: 400px; text-align: center; border: 1px solid #e2e8f0; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
        <h3>Swipe RFID Access Card</h3>
        <p style="color: #718096; font-size: 0.95em;">Please swipe your Staff RFID card to kick/open the cash drawer.</p>
        <div style="font-size: 4em; margin: 20px 0;">💳</div>
        
        <form method="post" asp-page-handler="OpenRegister">
            <input type="password" name="rfidCardId" id="rfidOverrideInput" placeholder="Card ID scans here..." style="width: 80%; padding: 10px; font-size: 1.2em; text-align: center; border: 1px solid #cbd5e0; border-radius: 4px;" required autocomplete="off" />
            <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: center;">
                <button type="button" onclick="closeRfidModal()" class="btn" style="flex:1;">Cancel</button>
                <button type="submit" class="btn btn-primary" style="flex:1;">Verify & Open</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 2: Split Payment Editor -->
<div id="splitPaymentModal" style="display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
    <div style="background-color: white; padding: 25px; border-radius: 8px; width: 450px; border: 1px solid #e2e8f0; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
        <h3>Split Payment Details</h3>
        <div style="font-size: 1.1em; margin-bottom: 12px;">
            Total Sale Cost: <strong style="color: #3182ce;"><span id="splitTotalText">0.00</span></strong>
        </div>
        <div style="font-size: 1.1em; margin-bottom: 15px;">
            Balance Remaining: <strong id="splitRemainingText" style="color: #e53e3e;">0.00</strong>
        </div>

        <table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
            <thead>
                <tr style="background-color: #eee;">
                    <th>Payment Method</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Transaction.PayMethod method in Enum.GetValues<Transaction.PayMethod>())
                {
                    if (method != Transaction.PayMethod.Mixed)
                    {
                        <tr>
                            <td><strong>@method</strong></td>
                            <td>
                                <input type="number" step="0.01" min="0" value="0.00" class="split-amount-input" data-method="@method" onchange="calculateSplitRemaining()" onkeyup="calculateSplitRemaining()" style="width: 100%; text-align: right; padding: 4px; border: 1px solid #cbd5e0; border-radius: 4px;" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div style="text-align: right; display: flex; gap: 10px;">
            <button type="button" onclick="closeSplitModal()" class="btn" style="flex: 1;">Cancel</button>
            <button type="button" id="confirmSplitBtn" onclick="confirmSplitPayments()" disabled class="btn btn-success" style="flex: 1;">Confirm Split</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.CurrencySymbol = "₱";
        window.SoundAlertsEnabled = true;

        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            return audioCtx;
        }

        function playSuccessSound() {
            if (!window.SoundAlertsEnabled) return;
            try {
                let ctx = getAudioContext();
                let osc = ctx.createOscillator();
                let gain = ctx.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                gain.gain.setValueAtTime(0.08, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.12);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.12);
            } catch (e) { console.error("Audio error", e); }
        }

        function playErrorSound() {
            if (!window.SoundAlertsEnabled) return;
            try {
                let ctx = getAudioContext();
                let osc = ctx.createOscillator();
                let gain = ctx.createGain();
                osc.type = "sawtooth";
                osc.frequency.setValueAtTime(220, ctx.currentTime);
                gain.gain.setValueAtTime(0.12, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.28);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.28);
            } catch (e) { console.error("Audio error", e); }
        }

        let cart = [];
        let catalog = [];

        @foreach (var item in Model.CatalogItems)
        {
            <text>
            catalog.push({
                id: @item.Id,
                name: '@Html.Raw(item.Name)',
                saleprice: @(item.SalePrice ?? 0f),
                barcode: '@(Html.Raw(item.Barcode ?? ""))',
                description: '@Html.Raw(item.Description ?? "")',
                tags: '@Html.Raw(string.Join(", ", item.Tags))'
            });
            </text>
        }

        let keypressBuffer = "";
        let lastKeypressTime = Date.now();

        window.addEventListener("keydown", function(e) {
            if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA" || e.target.tagName === "SELECT") return;

            let now = Date.now();
            let delta = now - lastKeypressTime;
            lastKeypressTime = now;
            if (delta > 200) keypressBuffer = "";

            if (e.key === "Enter") {
                let code = keypressBuffer.trim();
                keypressBuffer = "";
                if (code.length > 0) {
                    let rfidModal = document.getElementById("rfidModal");
                    if (rfidModal.style.display === "flex") {
                        let input = document.getElementById("rfidOverrideInput");
                        input.value = code;
                        input.form.submit();
                        e.preventDefault();
                        return;
                    }

                    let item = catalog.find(i => i.barcode === code);
                    if (item) {
                        addToCart(item.id, item.name, item.saleprice);
                        e.preventDefault();
                    } else {
                        playErrorSound();
                    }
                }
            } else if (e.key.length === 1) {
                keypressBuffer += e.key;
            }
        });

        function lookupManualBarcode() {
            let input = document.getElementById("manualBarcodeInput");
            let code = input.value.trim();
            if (code.length > 0) {
                let item = catalog.find(i => i.barcode === code);
                if (item) {
                    addToCart(item.id, item.name, item.saleprice);
                    input.value = "";
                } else {
                    playErrorSound();
                    alert("No item found matching barcode: " + code);
                }
            }
        }

        function handleManualBarcodeKeyPress(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                lookupManualBarcode();
            }
        }

        function filterPosCatalog() {
            let input = document.getElementById("posSearchInput");
            let filter = input.value.toLowerCase();
            let table = document.getElementById("posCatalogTable");
            let rows = table.getElementsByTagName("tr");
            for (let i = 1; i < rows.length; i++) {
                let item = catalog[i - 1];
                if (item) {
                    let text = (item.id + " " + item.name + " " + item.barcode + " " + item.description + " " + item.tags).toLowerCase();
                    rows[i].style.display = (text.indexOf(filter) > -1) ? "" : "none";
                }
            }
        }

        function addToCart(itemId, name, price) {
            let existing = cart.find(i => i.itemId === itemId);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ itemId: itemId, name: name, quantity: 1, unitPrice: price });
            }
            playSuccessSound();
            renderCart();
        }

        function updateQuantity(itemId, qty) {
            let item = cart.find(i => i.itemId === itemId);
            if (item) {
                item.quantity = parseFloat(qty);
                if (item.quantity <= 0 || isNaN(item.quantity)) {
                    removeFromCart(itemId);
                    return;
                }
            }
            renderCart();
        }

        function adjustCartQty(itemId, amount) {
            let item = cart.find(i => i.itemId === itemId);
            if (item) {
                item.quantity = parseFloat((item.quantity + amount).toFixed(1));
                if (item.quantity <= 0) {
                    removeFromCart(itemId);
                } else {
                    renderCart();
                }
            }
        }

        function removeFromCart(itemId) {
            cart = cart.filter(i => i.itemId !== itemId);
            playSuccessSound();
            renderCart();
        }

        function getCartTotal() {
            let total = 0;
            cart.forEach(item => {
                total += item.quantity * item.unitPrice;
            });
            return total;
        }

        function renderCart() {
            let tbody = document.getElementById("cartTableBody");
            let totalText = document.getElementById("cartTotalTextLabel");
            let cartJsonInput = document.getElementById("cartJsonInput");
            let totalAmountInput = document.getElementById("totalAmountInput");
            let checkoutBtn = document.getElementById("checkoutBtn");

            if (cart.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #a0aec0; padding: 15px;">Cart is empty</td></tr>';
                totalText.innerText = window.CurrencySymbol + "0.00";
                cartJsonInput.value = "";
                totalAmountInput.value = "0";
                checkoutBtn.disabled = true;
                return;
            }

            let html = "";
            let grandTotal = getCartTotal();

            cart.forEach(item => {
                let rowTotal = item.quantity * item.unitPrice;

                html += `<tr>
                    <td><strong>${item.name}</strong></td>
                    <td>
                        <div style="display: flex; align-items: center; gap: 4px;">
                            <button type="button" class="btn" style="padding: 2px 6px; font-size: 0.8em;" onclick="adjustCartQty(${item.itemId}, -1)">-</button>
                            <input type="number" step="0.1" min="0.1" value="${item.quantity}" onchange="updateQuantity(${item.itemId}, this.value)" style="width: 45px; text-align: center; padding: 2px;" />
                            <button type="button" class="btn" style="padding: 2px 6px; font-size: 0.8em;" onclick="adjustCartQty(${item.itemId}, 1)">+</button>
                        </div>
                    </td>
                    <td>${window.CurrencySymbol}${item.unitPrice.toFixed(2)}</td>
                    <td>${window.CurrencySymbol}${rowTotal.toFixed(2)}</td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="removeFromCart(${item.itemId})" style="padding: 2px 6px; font-size: 0.8em;">X</button>
                    </td>
                </tr>`;
            });

            tbody.innerHTML = html;
            totalText.innerText = window.CurrencySymbol + grandTotal.toFixed(2);
            totalAmountInput.value = grandTotal.toFixed(4);
            
            // Format for backend: List<CartItemDto> -> [{itemId, quantity, unitPrice}, ...]
            let submitData = cart.map(i => ({
                itemId: i.itemId,
                quantity: i.quantity,
                unitPrice: i.unitPrice
            }));
            cartJsonInput.value = JSON.stringify(submitData);
            
            checkoutBtn.disabled = false;
        }

        // Hardware simulation modals logic
        function showRfidModal() {
            let modal = document.getElementById("rfidModal");
            modal.style.display = "flex";
            document.getElementById("rfidOverrideInput").focus();
        }

        function closeRfidModal() {
            document.getElementById("rfidModal").style.display = "none";
        }

        function onPaymentMethodChanged() {
            let method = document.getElementById("paymentMethodSelect").value;
            let checkoutBtn = document.getElementById("checkoutBtn");
            if (method === "Mixed") {
                checkoutBtn.innerText = "Setup Split Payments...";
            } else {
                checkoutBtn.innerText = "Complete Checkout";
            }
        }

        // Split payments modal logic
        function showSplitPaymentModal() {
            let total = getCartTotal();
            document.getElementById("splitTotalText").innerText = window.CurrencySymbol + total.toFixed(2);
            calculateSplitRemaining();
            document.getElementById("splitPaymentModal").style.display = "flex";
        }

        function closeSplitModal() {
            document.getElementById("splitPaymentModal").style.display = "none";
        }

        function calculateSplitRemaining() {
            let total = getCartTotal();
            let inputs = document.querySelectorAll(".split-amount-input");
            let sum = 0;
            inputs.forEach(input => {
                let val = parseFloat(input.value);
                if (!isNaN(val) && val > 0) {
                    sum += val;
                }
            });

            let remaining = total - sum;
            let remainingText = document.getElementById("splitRemainingText");
            let confirmBtn = document.getElementById("confirmSplitBtn");

            remainingText.innerText = window.CurrencySymbol + remaining.toFixed(2);

            if (Math.abs(remaining) < 0.01) {
                remainingText.style.color = "green";
                confirmBtn.disabled = false;
            } else {
                remainingText.style.color = "red";
                confirmBtn.disabled = true;
            }
        }

        function confirmSplitPayments() {
            let inputs = document.querySelectorAll(".split-amount-input");
            let splits = [];
            inputs.forEach(input => {
                let amount = parseFloat(input.value);
                if (!isNaN(amount) && amount > 0) {
                    splits.push({
                        paymentMethod: input.getAttribute("data-method"),
                        amount: amount
                    });
                }
            });

            document.getElementById("splitPaymentsJsonInput").value = JSON.stringify(splits);
            closeSplitModal();
            
            // Re-submit the form
            document.getElementById("checkoutForm").submit();
        }

        function handleCheckoutSubmit(event) {
            let method = document.getElementById("paymentMethodSelect").value;
            if (method === "Mixed") {
                event.preventDefault();
                showSplitPaymentModal();
                return false;
            }
            
            let total = document.getElementById("cartTotalTextLabel").innerText;
            return confirm("Confirm total checkout amount of " + total + "?");
        }
    </script>
}
